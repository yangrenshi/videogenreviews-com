---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description,
  canonicalPath = '',
  ogType = 'website',
  schema,
} = Astro.props;

const siteUrl = 'https://videogenreviews.com';
const cleanCanonicalPath = canonicalPath.replace(/^\/|\/$/g, '');
const canonicalUrl = cleanCanonicalPath ? `${siteUrl}/${cleanCanonicalPath}/` : `${siteUrl}/`;

const defaultWebsiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'VideoGen Reviews',
  'url': siteUrl,
  'description': 'Editorial guides, side-by-side feature matrix, and pricing tracking for modern generative AI video platforms.',
};

const schemasToRender = [defaultWebsiteSchema];

if (schema) {
  if (Array.isArray(schema)) {
    schemasToRender.push(...schema);
  } else {
    schemasToRender.push(schema);
  }
}
---

<!doctype html>
<html lang="en" class="scroll-smooth antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Tag Manager / gtag -->
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-M9TKC2ZM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <!-- Google Fonts: Inter (高可读出版体系) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- 10 大核心 SEO 元标签 -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Impact.com Site Verification -->
    <meta name="impact-site-verification" value="1048c56c-f0af-4699-b8d9-bb4d61d7a486" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="VideoGen Reviews" />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

    <!-- JSON-LD 结构化数据 -->
    {
      schemasToRender.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }

    <style is:global>
      ::selection {
        background-color: #dbeafe;
        color: #1e3a8a;
      }
    </style>
  </head>
  <body class="bg-white text-ink-900 min-h-screen flex flex-col font-sans selection:bg-blue-100 selection:text-blue-900">
    <!-- 顶部透明披露条 (FTC Affiliate Disclosure) -->
    <div class="bg-paper-100 border-b border-paper-300/80 py-2 px-4 text-center text-xs text-ink-500 font-medium">
      <span>VideoGen Reviews is reader-supported. When you purchase through links on our site, we may earn an affiliate commission. </span>
      <a href="/affiliate-disclosure/" class="text-brand-blue hover:underline ml-1 font-semibold">Learn how we evaluate tools &rarr;</a>
    </div>

    <Header />
    <main class="flex-grow max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
