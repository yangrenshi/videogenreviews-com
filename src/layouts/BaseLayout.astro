---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogType?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description,
  canonicalPath = '',
  ogType = 'website',
  schema,
} = Astro.props;

const siteUrl = 'https://videogenreviews.com';
const cleanCanonicalPath = canonicalPath.replace(/^\/|\/$/g, '');
const canonicalUrl = cleanCanonicalPath ? `${siteUrl}/${cleanCanonicalPath}/` : `${siteUrl}/`;

// 全站通用组织与网站结构化数据
const defaultWebsiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'VideoGenReviews',
  'url': siteUrl,
  'description': 'Independent reviews, direct feature comparisons, and free tier breakdowns of modern AI video generators.',
};

const schemasToRender = [];
schemasToRender.push(defaultWebsiteSchema);

if (schema) {
  if (Array.isArray(schema)) {
    schemasToRender.push(...schema);
  } else {
    schemasToRender.push(schema);
  }
}
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- 10 大核心 SEO 元标签 -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="VideoGenReviews" />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

    <!-- JSON-LD 结构化数据 -->
    {
      schemasToRender.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col font-sans antialiased selection:bg-sky-500 selection:text-white">
    <Header />
    <main class="flex-grow max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
