---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KeyTakeaway from '../../components/KeyTakeaway.astro';
import FaqAccordion, { type FaqItem } from '../../components/FaqAccordion.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { PAGE_DATES } from '../../data/quotas';

const title = 'Viewmax AI is Now Everygen AI: What Changed & Migration Guide (2026)';
const description =
  'Viewmax AI has rebranded to Everygen AI under Viewmax LLC. Learn about the domain redirect, account migrations, 30s video capabilities, and pricing.';
const canonicalPath = 'viewmax-ai';

const faqs: FaqItem[] = [
  {
    question: 'Is Viewmax AI the same product as Everygen AI?',
    answer:
      'Yes. Everygen AI is the official rebrand and successor of Viewmax AI, operated by the same parent organization, Viewmax LLC. Existing accounts and user credentials migrate smoothly into the upgraded platform.',
  },
  {
    question: 'Where do viewmax.io and viewmax.ai redirect?',
    answer:
      'The legacy domains viewmax.io and viewmax.ai now redirect directly to everygen.ai. Existing bookmarks, subscription accounts, and login credentials function normally on everygen.ai.',
  },
  {
    question: 'What do existing Viewmax subscribers need to do?',
    answer:
      'Existing subscribers can log in directly at everygen.ai using their current credentials. Existing plan tiers, active credit balances, and commercial usage rights remain intact without requiring a new account.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: 'David Chen',
    url: 'https://videogenreviews.com/author/david-chen/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'VideoGen Reviews',
    url: 'https://videogenreviews.com',
  },
  datePublished: '2026-11-12',
  dateModified: PAGE_DATES.viewmax.iso,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://videogenreviews.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Viewmax AI Migration',
      item: 'https://videogenreviews.com/viewmax-ai/',
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  schema={[articleSchema, faqSchema, breadcrumbSchema]}
>
  <Breadcrumbs crumbs={[{ label: 'Viewmax AI Migration' }]} />

  <article class="space-y-10">
    <header class="border-b border-paper-300 pb-8">
      <div class="text-xs font-semibold text-brand-blue uppercase tracking-wider mb-2">
        Rebrand &amp; Migration Guide
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-900 tracking-tight leading-tight mb-4">
        Viewmax AI is Now Everygen AI: What Changed
      </h1>

      <p class="text-base sm:text-lg text-ink-700 leading-relaxed max-w-3xl font-normal mb-3">
        Looking for Viewmax AI? Viewmax LLC has formally transitioned the platform to Everygen AI. Both viewmax.io and viewmax.ai redirect to everygen.ai. Here is what existing users need to know about account migration and new platform capabilities.
      </p>

      <div class="text-xs text-ink-500 font-medium">
        Updated {PAGE_DATES.viewmax.display} &bull; Written by <a href="/author/david-chen/" class="text-brand-blue font-semibold hover:underline">David Chen</a> &bull; VideoGen Reviews Editorial Team
      </div>
    </header>

    <KeyTakeaway
      pickA="Seamless Domain Migration"
      forScenarioA="existing Viewmax users accessing accounts via everygen.ai without loss of credit balances"
      pickB="Upgraded Capabilities"
      forScenarioB="creators seeking 30-second continuous 1080p generation via Seedance 2.5 and Kling 4.0"
    />

    <!-- Domain Redirection Notice & Account Migration Steps -->
    <section class="rounded-lg border border-blue-200 bg-blue-50/50 p-6 space-y-4">
      <h2 class="text-xl font-bold text-ink-900 tracking-tight">
        Domain Redirection &amp; Existing Subscriber Action Plan
      </h2>
      <div class="space-y-3 text-sm text-ink-800 leading-relaxed">
        <p>
          The original web addresses <strong>viewmax.io</strong> and <strong>viewmax.ai</strong> now permanently redirect to <strong>everygen.ai</strong>. If you previously held an account or subscription with Viewmax AI:
        </p>
        <ul class="list-disc list-inside space-y-1.5 text-xs sm:text-sm text-ink-700">
          <li><strong>Direct Login:</strong> Navigate directly to <a href="https://everygen.ai" target="_blank" rel="noopener noreferrer" class="text-brand-blue font-semibold hover:underline">everygen.ai</a> and sign in using your existing Viewmax credentials.</li>
          <li><strong>Credit Balances Preserved:</strong> Active credit balances and purchased top-up packs transfer automatically to your Everygen dashboard.</li>
          <li><strong>Billing Continuity:</strong> Active subscriptions continue under Viewmax LLC without requiring re-entry of payment methods.</li>
        </ul>
      </div>
    </section>

    <!-- Why Viewmax LLC Rebranded -->
    <section class="space-y-4 pt-4">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Why Viewmax LLC Rebranded to Everygen AI
      </h2>
      <div class="space-y-4 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          When Viewmax LLC originally launched <strong>Viewmax AI</strong>, the product focused on basic image generation and standard 4-to-5-second video clips. As generative video diffusion matured, the platform expanded its backend into a unified multi-engine hub.
        </p>
        <p>
          The rebranding to <strong>Everygen AI</strong> reflects this broader scope: providing creators access to multiple frontier video engines—including Seedance 2.5, Kling 4.0, and Gemini Omni 1.1 Flash—from a single dashboard.
        </p>
      </div>
    </section>

    <!-- Side-by-Side Summary of Platform Upgrades -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Key Upgrades from Viewmax AI to Everygen AI
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        <div class="p-5 rounded-lg border border-paper-300 bg-paper-100 space-y-2">
          <span class="text-xs uppercase font-bold text-brand-blue">Duration</span>
          <div class="text-lg font-bold text-ink-900">30s vs 5s Clips</div>
          <p class="text-xs text-ink-700 leading-relaxed">
            While Viewmax was historically limited to short 4 to 5-second bursts, Everygen introduces native 30-second continuous 1080p scene rendering via Seedance 2.5.
          </p>
        </div>

        <div class="p-5 rounded-lg border border-paper-300 bg-paper-100 space-y-2">
          <span class="text-xs uppercase font-bold text-purple-700">Model Selection</span>
          <div class="text-lg font-bold text-ink-900">Multi-Model Hub</div>
          <p class="text-xs text-ink-700 leading-relaxed">
            Switch dynamically between Seedance 2.5 for continuous takes, Kling 4.0 for athletic physics, and Gemini Omni 1.1 Flash for rapid multimodal workflows.
          </p>
        </div>

        <div class="p-5 rounded-lg border border-paper-300 bg-paper-100 space-y-2">
          <span class="text-xs uppercase font-bold text-emerald-800">Unified Pricing</span>
          <div class="text-lg font-bold text-ink-900">Shared Credit Ledger</div>
          <p class="text-xs text-ink-700 leading-relaxed">
            A single credit balance applies across all supported video engines, starting from $24/mo ($9/mo billed annually).
          </p>
        </div>
      </div>
    </section>

    <!-- Navigation Hub (Clean 1-sentence summaries + links) -->
    <section class="rounded-lg bg-paper-100 border border-paper-300 p-6 sm:p-8 space-y-3">
      <h2 class="text-lg font-bold text-ink-900">Explore Everygen AI Further</h2>
      <p class="text-sm text-ink-700 leading-relaxed">
        For detailed performance tests and output quality, read our hands-on <a href="/everygen-ai-review/" class="text-brand-blue font-semibold hover:underline">Everygen AI Review</a>. To examine plan costs and credit conversions, see <a href="/everygen-ai-pricing/" class="text-brand-blue font-semibold hover:underline">Everygen AI Pricing</a>, or review account quotas in <a href="/is-everygen-ai-free/" class="text-brand-blue font-semibold hover:underline">Is Everygen AI Free?</a>.
      </p>
    </section>

    <!-- FAQs -->
    <FaqAccordion faqs={faqs} />
  </article>
</BaseLayout>
