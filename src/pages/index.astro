---
import BaseLayout from '../layouts/BaseLayout.astro';
import KeyTakeaway from '../components/KeyTakeaway.astro';
import FaqAccordion, { type FaqItem } from '../components/FaqAccordion.astro';
import { BUILD_DATE_ISO, BUILD_DATE_DISPLAY } from '../data/quotas';

const title = 'Everygen AI (Formerly Viewmax): Models, Free Credits & Pricing';
const description = 'Comprehensive guide to Everygen AI (Viewmax LLC). Explore 5 engines (Kling 4.0, Seedance 2.5, MiniMax H3 Max, Grok Imagine, Gemini Omni 1.1 Flash) & MCP.';
const canonicalPath = '';

const faqs: FaqItem[] = [
  {
    question: 'What is Everygen AI?',
    answer:
      'Everygen AI is an enterprise-ready multimodal generation suite operated by Viewmax LLC. It orchestrates high-tier video generation and multimodal diffusion backends—including Kling 4.0, Seedance 2.5, MiniMax H3 Max, Grok Imagine, and Gemini Omni 1.1 Flash—under one centralized platform.',
  },
  {
    question: 'Does Everygen AI support MCP (Model Context Protocol)?',
    answer:
      'Yes. Everygen officially supports the Model Context Protocol (MCP) for agentic developer workflows across Claude Desktop, ChatGPT, Cursor, and Windsurf. As detailed in the official setup documentation (everygen.ai/mcp/setup), connections are authenticated via OAuth, requiring users to explicitly confirm credit consumption prior to each video generation dispatch.',
  },
  {
    question: 'What is the maximum continuous video duration on Everygen AI?',
    answer:
      'Unlike first-generation generators capped at 4 or 5 seconds, Everygen supports up to 30-second generations at 1080p resolution on modern integrated engines such as Seedance 2.5 and Kling 4.0 with reference image conditioning.',
  },
  {
    question: 'How do free credits and trial quotas work on Everygen AI?',
    answer:
      'Everygen provides an initial allocation of 10 promotional credits for newly registered accounts. Because an entry-level fast 5s render (Seedance 2 Fast) requires ~11 credits and standard runs consume ~16.4–19.2 credits, active video creation begins with the Starter tier ($9/mo annual) or top-up credit bundles.',
  },
  {
    question: 'How does Everygen AI compare to standalone tools like Runway or Kling?',
    answer:
      'Everygen AI acts as an aggregation and developer orchestration layer. If you need unified billing across multiple frontier models and agentic generation via MCP, Everygen offers substantial efficiency. If you require specialized UI tools like Runway\'s multi-motion brush or Kling\'s daily recurring free tier, standalone access may be preferable.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: 'David Chen',
    url: 'https://videogenreviews.com/author/david-chen/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'VideoGen Reviews',
    url: 'https://videogenreviews.com',
  },
  datePublished: '2026-11-12',
  dateModified: BUILD_DATE_ISO,
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  schema={[articleSchema, faqSchema]}
>
  <div class="space-y-12">
    <!-- Hero / Platform Architecture Section -->
    <header class="border-b border-paper-300 pb-8">
      <div class="text-xs font-semibold text-brand-blue uppercase tracking-wider mb-2">
        Platform Guide & Architecture Analysis
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-900 tracking-tight leading-tight mb-4">
        Everygen AI (Formerly Viewmax): Models, Capabilities & Pricing
      </h1>

      <p class="text-base sm:text-lg text-ink-700 leading-relaxed max-w-3xl font-normal mb-3">
        An editorial breakdown of Everygen AI by Viewmax LLC: examining supported foundational engines (Kling 4.0, Seedance 2.5, MiniMax H3 Max, Grok Imagine, Gemini Omni 1.1 Flash), 30-second 1080p rendering, and official Model Context Protocol (MCP) agent interoperability.
      </p>

      <div class="text-xs text-ink-500 font-medium">
        Updated {BUILD_DATE_DISPLAY} &bull; Written by <a href="/author/david-chen/" class="text-brand-blue font-semibold hover:underline">David Chen</a> &bull; VideoGen Reviews Editorial Team
      </div>
    </header>

    <!-- 快速导航入口三卡片 (消除 H 标签跳级，改用语义纯净的 div) -->
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a
        href="/everygen-ai-alternatives/"
        class="rounded-lg border border-paper-300 bg-paper-100 hover:border-brand-blue hover:bg-blue-50/30 p-5 transition-colors group"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-brand-blue block mb-1">Ranked Matrix</span>
        <div class="text-base font-bold text-ink-900 group-hover:text-brand-blue transition-colors flex items-center justify-between">
          <span>Top 10 Alternatives</span>
          <span>&rarr;</span>
        </div>
        <p class="text-xs text-ink-600 mt-2 leading-relaxed">
          Compare 10 standalone generators including Kling 4.0, PixVerse V6, OpenArt, and Runway Gen-4.5.
        </p>
      </a>

      <a
        href="/is-everygen-ai-free/"
        class="rounded-lg border border-paper-300 bg-paper-100 hover:border-brand-blue hover:bg-blue-50/30 p-5 transition-colors group"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 block mb-1">Account Rules</span>
        <div class="text-base font-bold text-ink-900 group-hover:text-brand-blue transition-colors flex items-center justify-between">
          <span>Free Credits & Trial</span>
          <span>&rarr;</span>
        </div>
        <p class="text-xs text-ink-600 mt-2 leading-relaxed">
          Understand trial credits, watermark policies, and genuinely free daily refill quotas.
        </p>
      </a>

      <a
        href="/everygen-ai-review/"
        class="rounded-lg border border-paper-300 bg-paper-100 hover:border-brand-blue hover:bg-blue-50/30 p-5 transition-colors group"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-800 block mb-1">Lab Analysis</span>
        <div class="text-base font-bold text-ink-900 group-hover:text-brand-blue transition-colors flex items-center justify-between">
          <span>System Review</span>
          <span>&rarr;</span>
        </div>
        <p class="text-xs text-ink-600 mt-2 leading-relaxed">
          Deep dive into multi-model routing, prompt alignment, and MCP developer workflows.
        </p>
      </a>
    </section>

    <!-- Key Takeaway -->
    <KeyTakeaway
      pickA="Everygen AI"
      forScenarioA="integrated multi-model access (Seedance 2.5, Kling 4.0, MiniMax H3 Max, Grok Imagine, Gemini Omni 1.1 Flash) with native MCP agent integration"
      pickB="Runway Gen-4.5 or Luma Ray 3.2"
      forScenarioB="dedicated studio post-production suites with keyframed camera velocity curves"
    />

    <!-- 1. What is Everygen AI? (Core Explainer & Viewmax Evolution) -->
    <section class="space-y-4 pt-4">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        What is Everygen AI? The Viewmax LLC Evolution
      </h2>
      <div class="space-y-4 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          <strong>Everygen AI</strong> is an enterprise multimodal synthesis hub developed and operated by <strong>Viewmax LLC</strong>. Originally launched under the product identity <em>Viewmax AI</em>, the suite was formally rebranded to Everygen to signify its technical departure from single-model wrappers toward a high-throughput, multi-engine orchestration architecture.
        </p>
        <p>
          In the rapidly fragmenting landscape of artificial visual intelligence, creative studios face significant operational overhead managing disconnected subscription tiers, disparate billing APIs, and divergent prompting conventions across multiple vendors. Everygen AI addresses this fragmentation by consolidating leading generative video and visual diffusion backends into a single coordinated console and hosted MCP gateway.
        </p>
        <p>
          Rather than training an isolated proprietary foundation model from scratch, Everygen acts as an intelligent inference broker. It routes generative user requests to specialized state-of-the-art weights based on user intent—allocating complex physical human choreographies to <strong>Kling 4.0</strong> (and Kling 3.0 Pro/Turbo via MCP), continuous sustained narrative shots to <strong>Seedance 2.5</strong>, organic human facial portraits with native audio to <strong>MiniMax H3 Max</strong>, expressive sound-synchronized clips to <strong>Grok Imagine</strong>, and rapid generative video workflows to <strong>Gemini Omni 1.1 Flash</strong>.
        </p>
      </div>
    </section>

    <!-- 2. Integrated Model Architecture Matrix (核心对比矩阵表) -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Everygen Integrated Engine Capabilities Matrix
      </h2>
      <p class="text-sm text-ink-700 leading-relaxed">
        Everygen orchestrates five principal foundational video engines. The following matrix details native durations, maximum resolutions, audio/character anchoring constraints, and primary optimal use-cases.
      </p>

      <div class="overflow-x-auto rounded-lg border border-paper-300 mt-4">
        <table class="min-w-full divide-y divide-paper-300 text-left text-xs sm:text-sm">
          <thead class="bg-paper-100 font-semibold text-ink-900">
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3">Model Engine</th>
              <th scope="col" class="px-3 py-3.5">Output Format &amp; Duration</th>
              <th scope="col" class="px-3 py-3.5">Resolution</th>
              <th scope="col" class="px-3 py-3.5">Key Capability</th>
              <th scope="col" class="px-3 py-3.5 pr-4">Primary Strength</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-paper-300 bg-white text-ink-700">
            <tr>
              <td class="py-3.5 pl-4 pr-3 font-semibold text-ink-900">Seedance 2.5</td>
              <td class="px-3 py-3.5 text-brand-blue font-medium">30 seconds</td>
              <td class="px-3 py-3.5">1080p FHD</td>
              <td class="px-3 py-3.5">Dual-frame keyframing</td>
              <td class="px-3 py-3.5 pr-4">Long-form continuous sequences without scene drift</td>
            </tr>
            <tr>
              <td class="py-3.5 pl-4 pr-3 font-semibold text-ink-900">Kling AI 4.0</td>
              <td class="px-3 py-3.5 text-brand-blue font-medium">30 seconds</td>
              <td class="px-3 py-3.5">1080p FHD</td>
              <td class="px-3 py-3.5">Multi-angle facial lock</td>
              <td class="px-3 py-3.5 pr-4">Complex biomechanics, athletic physics & liquid flow</td>
            </tr>
            <tr>
              <td class="py-3.5 pl-4 pr-3 font-semibold text-ink-900">MiniMax H3 Max</td>
              <td class="px-3 py-3.5">6 to 10 seconds</td>
              <td class="px-3 py-3.5">1080p FHD</td>
              <td class="px-3 py-3.5">Native audio & facial lock</td>
              <td class="px-3 py-3.5 pr-4">Photorealistic facial anatomy, skin pores & natural eyes</td>
            </tr>
            <tr>
              <td class="py-3.5 pl-4 pr-3 font-semibold text-ink-900">Grok Imagine</td>
              <td class="px-3 py-3.5">Short clips</td>
              <td class="px-3 py-3.5">1080p FHD</td>
              <td class="px-3 py-3.5">Synchronized sound</td>
              <td class="px-3 py-3.5 pr-4">Short video clips generated with native synchronized audio</td>
            </tr>
            <tr>
              <td class="py-3.5 pl-4 pr-3 font-semibold text-ink-900">Gemini Omni 1.1 Flash</td>
              <td class="px-3 py-3.5">Multi-scene clips</td>
              <td class="px-3 py-3.5">1080p FHD</td>
              <td class="px-3 py-3.5">Multimodal editing</td>
              <td class="px-3 py-3.5 pr-4">High-speed multimodal video generation and instruction-guided editing</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 3. Two Critical Technical Differentiators: 30s & MCP -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Two Core Architectural Differentiators
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <div class="rounded-lg border border-paper-300 bg-paper-100 p-5 space-y-2">
          <h3 class="text-base font-bold text-ink-900">1. Long-Form 30-Second 1080p Generation</h3>
          <p class="text-sm text-ink-700 leading-relaxed">
            While consumer video diffusion tools historically restricted clip outputs to brief 4 or 5-second bursts, Everygen leverages continuous temporal sequence synthesis through Seedance 2.5 and Kling 4.0. Characters maintain anatomical proportions, cloth simulation physics remain coherent, and background geometry remains anchored across full 30-second takes.
          </p>
        </div>

        <div class="rounded-lg border border-paper-300 bg-paper-100 p-5 space-y-2">
          <h3 class="text-base font-bold text-ink-900">2. Native Model Context Protocol (MCP) Support</h3>
          <p class="text-sm text-ink-700 leading-relaxed">
            Everygen natively implements Anthropic's open Model Context Protocol. Rather than switching between fragmented browser consoles, developers connect their account to IDE agents like Claude Desktop, Cursor, Windsurf, or ChatGPT to generate and iterate video assets within their native coding workflow.
          </p>
        </div>
      </div>
    </section>

    <!-- 4. Developer Workflow: Official MCP Integration -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Connecting Everygen via Official Model Context Protocol (MCP)
      </h2>
      <p class="text-sm text-ink-700 leading-relaxed">
        Rather than requiring manual API keys or unverified package installations, Everygen provides an official hosted MCP server accessible via OAuth authentication. Technical creators can review setup instructions directly at the official <a href="https://everygen.ai/mcp/setup" target="_blank" rel="noopener noreferrer" class="text-brand-blue font-semibold hover:underline">everygen.ai/mcp/setup</a> guide.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs pt-2">
        <div class="p-4 rounded-lg border border-paper-300 bg-paper-100 space-y-1.5">
          <span class="font-bold text-ink-900 block">1. Supported Clients</span>
          <p class="text-ink-700 leading-relaxed">
            Native interoperability with Claude Desktop, Cursor, Windsurf, and ChatGPT agentic desktop environments.
          </p>
        </div>
        <div class="p-4 rounded-lg border border-paper-300 bg-paper-100 space-y-1.5">
          <span class="font-bold text-ink-900 block">2. OAuth Authentication</span>
          <p class="text-ink-700 leading-relaxed">
            Direct account authorization through the official setup portal without exposing hardcoded API credentials.
          </p>
        </div>
        <div class="p-4 rounded-lg border border-paper-300 bg-paper-100 space-y-1.5">
          <span class="font-bold text-ink-900 block">3. Credit Guardrails</span>
          <p class="text-ink-700 leading-relaxed">
            The MCP server requires explicit user approval before executing generations, displaying estimated credit burn prior to render.
          </p>
        </div>
      </div>
    </section>

    <!-- 5. Compute Credit Economics & Pricing Strategy -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Compute Credit Economics &amp; Billing Structure
      </h2>
      <p class="text-sm text-ink-700 leading-relaxed">
        Because Everygen orchestrates third-party diffusion clusters, credit burn rates are dynamic rather than flat-rate. A 5-second 720p draft render consumes significantly fewer compute credits than a full 30-second 1080p high-fidelity generation conditioned on multiple reference images.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
        <div class="p-4 rounded-md border border-paper-300 bg-white space-y-1">
          <span class="text-xs uppercase font-semibold text-ink-500">Draft Tier</span>
          <div class="text-lg font-bold text-ink-900">720p Standard</div>
          <p class="text-xs text-ink-600">Optimized for fast ideation, prompt validation, and camera blocking.</p>
        </div>
        <div class="p-4 rounded-md border border-paper-300 bg-white space-y-1">
          <span class="text-xs uppercase font-semibold text-brand-blue">Production Tier</span>
          <div class="text-lg font-bold text-ink-900">1080p Seedance 2.5</div>
          <p class="text-xs text-ink-600">Full 30-second continuous scenes suitable for cinematic composition.</p>
        </div>
        <div class="p-4 rounded-md border border-paper-300 bg-white space-y-1">
          <span class="text-xs uppercase font-semibold text-purple-700">Physics Tier</span>
          <div class="text-lg font-bold text-ink-900">1080p Kling 4.0</div>
          <p class="text-xs text-ink-600">Advanced multi-character reference locking and high-velocity simulation.</p>
        </div>
      </div>
    </section>

    <!-- 6. Editorial Recommendations & Next Steps -->
    <section class="rounded-lg bg-paper-100 border border-paper-300 p-6 sm:p-8 space-y-4">
      <h2 class="text-xl font-bold text-ink-900 tracking-tight">
        Editorial Guidance: Is Everygen AI Right for Your Production?
      </h2>
      <div class="space-y-3 text-sm text-ink-800 leading-relaxed">
        <p>
          If your creative process relies on testing multiple model architectures simultaneously or orchestrating video tasks via official developer MCP agents, Everygen AI provides substantial consolidation benefits over juggling multiple individual vendor subscriptions.
        </p>
        <p>
          However, creators requiring specialized graphical post-production tools—such as Runway's granular multi-motion brush or dedicated timeline video editors—may achieve higher precision within standalone creative environments. For an exhaustive breakdown of alternative options, explore our <a href="/everygen-ai-alternatives/" class="text-brand-blue font-semibold hover:underline">10 Best Everygen AI Alternatives for 2026</a>.
        </p>
      </div>
    </section>

    <!-- FAQs (统一合规 H2 标题) -->
    <FaqAccordion faqs={faqs} />
  </div>
</BaseLayout>
