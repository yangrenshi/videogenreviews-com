---
import BaseLayout from '../layouts/BaseLayout.astro';
import KeyTakeaway from '../components/KeyTakeaway.astro';
import FaqAccordion, { type FaqItem } from '../components/FaqAccordion.astro';
import { PAGE_DATES } from '../data/quotas';

const title = 'Everygen AI (2026): Review, Pricing & Free Trial Explained';
const description =
  'What Everygen AI (formerly Viewmax) actually costs, what it can generate, and whether the free credits are usable. Verified against official pricing on 2026-11-23.';
const canonicalPath = '';

const faqs: FaqItem[] = [
  {
    question: 'What is Everygen AI?',
    answer:
      'Everygen AI (formerly Viewmax AI) is a multimodal generative video platform that provides unified access to leading video generation models, including Seedance 2.5, Kling 4.0, and Gemini Omni 1.1 Flash, under a single subscription credit system.',
  },
  {
    question: 'Can you generate video for free on Everygen AI?',
    answer:
      'No. While newly registered accounts receive 10 promotional signup credits, an entry-level fast 5-second generation requires ~11 credits, meaning 10 credits fall below the minimum rendering threshold. An active paid plan or credit pack is required to generate video.',
  },
  {
    question: 'How much does Everygen AI cost?',
    answer:
      'Everygen offers three subscription tiers: Starter at $24/month ($9/month billed annually at $108/year for ~200 credits), Pro at $49/month ($19/month billed annually at $228/year for ~500 credits), and Creator at $139/month ($49/month billed annually at $588/year for ~1,000 credits).',
  },
  {
    question: 'What is the maximum continuous video duration on Everygen AI?',
    answer:
      'Everygen supports native 30-second continuous 1080p generation through Seedance 2.5, while Kling 4.0 generates 5–10 second clips per pass that can be composed on the platform up to 30 seconds.',
  },
  {
    question: 'How does Everygen AI compare to standalone tools?',
    answer:
      'Everygen acts as a unified aggregator for multiple video models under one subscription. If you need specialized standalone UI tools like Runway motion brushes or Kling recurring daily free credits, standalone access may be preferable.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: 'David Chen',
    url: 'https://videogenreviews.com/author/david-chen/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'VideoGen Reviews',
    url: 'https://videogenreviews.com',
  },
  datePublished: '2026-11-12',
  dateModified: PAGE_DATES.home.iso,
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  schema={[articleSchema, faqSchema]}
>
  <div class="space-y-12">
    <!-- Hero / Platform Overview Header -->
    <header class="border-b border-paper-300 pb-8">
      <div class="text-xs font-semibold text-brand-blue uppercase tracking-wider mb-2">
        Platform Overview &amp; Verification Guide
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-900 tracking-tight leading-tight mb-4">
        Everygen AI: Review, Pricing &amp; Free Trial
      </h1>

      <p class="text-base sm:text-lg text-ink-700 leading-relaxed max-w-3xl font-normal mb-3">
        What Everygen AI (formerly Viewmax) actually costs, what it can generate, and whether the free trial credits are usable. An editorial overview cross-referenced directly against official published documentation.
      </p>

      <div class="text-xs text-ink-500 font-medium">
        Updated {PAGE_DATES.home.display} &bull; Written by <a href="/author/david-chen/" class="text-brand-blue font-semibold hover:underline">David Chen</a> &bull; VideoGen Reviews Editorial Team
      </div>
    </header>

    <!-- Quick Verdict Component -->
    <KeyTakeaway
      pickA="Everygen AI"
      forScenarioA="integrated multi-model video generation (Seedance 2.5, Kling 4.0, Gemini Omni 1.1 Flash) under a unified monthly or annual credit pool"
      pickB="Runway Gen-4.5 or Kling AI Direct"
      forScenarioB="dedicated standalone studio post-production interfaces or daily recurring free credits"
    />

    <!-- Three Direct Pillar Navigation Gateways -->
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a
        href="/everygen-ai-review/"
        class="rounded-lg border border-paper-300 bg-paper-100 hover:border-brand-blue hover:bg-blue-50/30 p-5 transition-colors group"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-800 block mb-1">Hands-On Test</span>
        <div class="text-base font-bold text-ink-900 group-hover:text-brand-blue transition-colors flex items-center justify-between">
          <span>Hands-On Review</span>
          <span>&rarr;</span>
        </div>
        <p class="text-xs text-ink-600 mt-2 leading-relaxed">
          Prompt benchmark tests, rendering speed, 30-second sequence stability, and output limits.
        </p>
      </a>

      <a
        href="/everygen-ai-pricing/"
        class="rounded-lg border border-paper-300 bg-paper-100 hover:border-brand-blue hover:bg-blue-50/30 p-5 transition-colors group"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-brand-blue block mb-1">Cost &amp; Yield</span>
        <div class="text-base font-bold text-ink-900 group-hover:text-brand-blue transition-colors flex items-center justify-between">
          <span>Pricing &amp; Plans</span>
          <span>&rarr;</span>
        </div>
        <p class="text-xs text-ink-600 mt-2 leading-relaxed">
          Monthly vs annual plan costs ($24 vs $9/mo), credit yield calculations, and rollover rules.
        </p>
      </a>

      <a
        href="/is-everygen-ai-free/"
        class="rounded-lg border border-paper-300 bg-paper-100 hover:border-brand-blue hover:bg-blue-50/30 p-5 transition-colors group"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 block mb-1">Trial Policy</span>
        <div class="text-base font-bold text-ink-900 group-hover:text-brand-blue transition-colors flex items-center justify-between">
          <span>Free Trial &amp; Limits</span>
          <span>&rarr;</span>
        </div>
        <p class="text-xs text-ink-600 mt-2 leading-relaxed">
          10 promotional signup credits breakdown, watermark requirements, and genuinely free alternatives.
        </p>
      </a>
    </section>

    <!-- 1. What is Everygen AI? (Overview Gateway) -->
    <section class="space-y-4 pt-2">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        What is Everygen AI?
      </h2>
      <div class="space-y-4 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          <strong>Everygen AI</strong> is a centralized multimodal video generation platform operated by <strong>Viewmax LLC</strong> (formerly marketed under the name <em>Viewmax AI</em>). Rather than operating a single isolated diffusion model, Everygen brings together high-tier generative video models—including <strong>Seedance 2.5</strong>, <strong>Kling 4.0</strong>, and <strong>Gemini Omni 1.1 Flash</strong>—into a single web dashboard and unified compute credit system.
        </p>
        <p>
          For digital creators and video teams, this architecture eliminates the need to maintain separate subscriptions, billing portals, and API keys across individual video model providers. Users purchase credits that can be allocated dynamically across supported models based on specific production demands.
        </p>
      </div>
    </section>

    <!-- 2. Supported Models & Video Capabilities (Concise Summary + Link to Review) -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Supported Models &amp; Video Capabilities
      </h2>
      <div class="space-y-3 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          Everygen provides access to multiple model backends with distinct strengths: Seedance 2.5 delivers native continuous 30-second sequences at 1080p, Kling 4.0 handles high-motion dynamic scenes with multi-angle reference locking, and Gemini Omni 1.1 Flash powers fast multimodal video workflows.
        </p>
        <p class="text-sm text-ink-700 bg-paper-100 p-4 rounded-lg border border-paper-300">
          For detailed prompt benchmark results, temporal consistency evaluations, and resolution tests, read our full hands-on <a href="/everygen-ai-review/" class="text-brand-blue font-semibold hover:underline">Everygen AI Review</a>.
        </p>
      </div>
    </section>

    <!-- 3. Pricing & Credit Economics (Concise Summary + Link to Pricing) -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Pricing Plans &amp; Credit Structure
      </h2>
      <div class="space-y-3 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          Everygen subscriptions start at $24/month on the monthly schedule, or $9/month ($108/year) billed annually for the Starter tier (~200 credits). Pro is priced at $49/month or $19/month annual (~500 credits), and Creator is $139/month or $49/month annual (~1,000 credits). <span class="source-note text-xs text-ink-500 font-mono">Source: everygen.ai/pricing &middot; Last verified: 2026-11-23</span>
        </p>
        <p class="text-sm text-ink-700 bg-paper-100 p-4 rounded-lg border border-paper-300">
          For full monthly vs annual comparisons, credit conversion formulas, and estimated monthly clip yields, visit our dedicated <a href="/everygen-ai-pricing/" class="text-brand-blue font-semibold hover:underline">Everygen AI Pricing Breakdown</a>.
        </p>
      </div>
    </section>

    <!-- 4. Free Trial & Usability (Concise Summary + Link to Is-Free) -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Free Trial &amp; Credit Usability
      </h2>
      <div class="space-y-3 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          Everygen offers 10 promotional signup credits upon account creation, but does not provide a permanent recurring free tier. Because an entry-level fast 5-second render consumes approximately 11 credits, the 10-credit signup bonus cannot render a full clip on its own. <span class="source-note text-xs text-ink-500 font-mono">Source: everygen.ai/pricing &middot; Last verified: 2026-11-23</span>
        </p>
        <p class="text-sm text-ink-700 bg-paper-100 p-4 rounded-lg border border-paper-300">
          To understand credit consumption rules, watermark policies, or to explore tools with genuinely daily replenishing free tiers like Kling AI or PixVerse, see <a href="/is-everygen-ai-free/" class="text-brand-blue font-semibold hover:underline">Is Everygen AI Free?</a>.
        </p>
      </div>
    </section>

    <!-- 5. Editorial Next Steps & Alternatives -->
    <section class="rounded-lg bg-paper-100 border border-paper-300 p-6 sm:p-8 space-y-4">
      <h2 class="text-xl font-bold text-ink-900 tracking-tight">
        Next Steps &amp; Market Alternatives
      </h2>
      <div class="space-y-3 text-sm text-ink-800 leading-relaxed">
        <p>
          If you are looking to benchmark Everygen against other AI video platforms, we maintain independent side-by-side comparisons of leading tools across pricing, motion quality, and duration limits:
        </p>
        <ul class="list-disc list-inside space-y-1 text-ink-700">
          <li><a href="/everygen-ai-alternatives/" class="text-brand-blue font-semibold hover:underline">10 Best Everygen AI Alternatives for 2026</a> &mdash; Ranked standalone platforms and direct competitors.</li>
          <li><a href="/best-ai-video-generator/" class="text-brand-blue font-semibold hover:underline">Best AI Video Generators (2026 Guide)</a> &mdash; Overall market evaluation and category winners.</li>
          <li><a href="/viewmax-ai/" class="text-brand-blue font-semibold hover:underline">Viewmax AI Rebranding Guide</a> &mdash; What happened to Viewmax AI and transition instructions.</li>
        </ul>
      </div>
    </section>

    <!-- FAQs -->
    <FaqAccordion faqs={faqs} />
  </div>
</BaseLayout>
