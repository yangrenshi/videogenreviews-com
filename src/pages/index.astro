---
import BaseLayout from '../layouts/BaseLayout.astro';
import KeyTakeaway from '../components/KeyTakeaway.astro';
import FaqAccordion, { type FaqItem } from '../components/FaqAccordion.astro';

const title = 'Everygen AI (Formerly Viewmax): Models, Free Credits & Pricing';
const description = 'Comprehensive guide to Everygen AI (Viewmax LLC). Explore supported foundational engines (Kling 4.0, Seedance 2.5), MCP agent integration, and credit rules.';
const canonicalPath = '';

const faqs: FaqItem[] = [
  {
    question: 'What is Everygen AI?',
    answer:
      'Everygen AI is an advanced AI visual generation suite operated by Viewmax LLC. It unifies high-tier text-to-video, image-to-video, and image diffusion backends—including Kling 4.0, Seedance 2.5, MiniMax H3 Max, and Grok Imagine—under one centralized platform.',
  },
  {
    question: 'Does Everygen AI support MCP (Model Context Protocol)?',
    answer:
      'Yes. One of Everygen AI\'s standout architectural features is native Model Context Protocol (MCP) support. This allows developers and power users to generate and manage video assets directly inside agentic developer tools like Cursor, Claude Desktop, and ChatGPT.',
  },
  {
    question: 'What is the maximum video duration on Everygen AI?',
    answer:
      'Unlike first-generation generators capped at 5 seconds, Everygen supports up to 30-second generations at 1080p resolution on modern integrated engines such as Seedance 2.5 and Kling 4.0 with reference image conditioning.',
  },
  {
    question: 'How do free credits work on Everygen AI?',
    answer:
      'Everygen provides initial trial credits for newly registered accounts to sample supported models. Generation requirements vary by resolution and model selection. Dynamic pricing packages and top-up bundles are listed on the official platform.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  schema={faqSchema}
>
  <div class="space-y-12">
    <!-- Hero / Platform Architecture Section -->
    <header class="border-b border-paper-300 pb-8">
      <div class="text-xs font-semibold text-brand-blue uppercase tracking-wider mb-2">
        Platform Guide & Architecture Analysis
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-900 tracking-tight leading-tight mb-4">
        Everygen AI (Formerly Viewmax): Models, Capabilities & Pricing
      </h1>

      <p class="text-base sm:text-lg text-ink-700 leading-relaxed max-w-3xl font-normal mb-3">
        An editorial breakdown of Everygen AI by Viewmax LLC: examining supported foundational engines (Kling 4.0, Seedance 2.5), 30-second 1080p rendering, and native Model Context Protocol (MCP) client interoperability.
      </p>

      <div class="text-xs text-ink-500 font-medium">
        Updated November 2026 &bull; Published by VideoGen Reviews
      </div>
    </header>

    <!-- 快速导航入口三卡片 (浅色出版风) -->
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <a
        href="/everygen-ai-alternatives/"
        class="rounded-lg border border-paper-300 bg-paper-100 hover:border-brand-blue hover:bg-blue-50/30 p-5 transition-colors group"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-brand-blue block mb-1">Ranked Matrix</span>
        <h3 class="text-base font-bold text-ink-900 group-hover:text-brand-blue transition-colors flex items-center justify-between">
          <span>Top Alternatives</span>
          <span>&rarr;</span>
        </h3>
        <p class="text-xs text-ink-600 mt-2 leading-relaxed">
          Compare 10 standalone generators like Kling 4.0, Seedance 2.5, and Runway Gen-3.
        </p>
      </a>

      <a
        href="/is-everygen-ai-free/"
        class="rounded-lg border border-paper-300 bg-paper-100 hover:border-brand-blue hover:bg-blue-50/30 p-5 transition-colors group"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-800 block mb-1">Account Rules</span>
        <h3 class="text-base font-bold text-ink-900 group-hover:text-brand-blue transition-colors flex items-center justify-between">
          <span>Free Credits & Trial</span>
          <span>&rarr;</span>
        </h3>
        <p class="text-xs text-ink-600 mt-2 leading-relaxed">
          Understand trial credits, watermark policies, and genuinely free daily tools.
        </p>
      </a>

      <a
        href="/everygen-ai-review/"
        class="rounded-lg border border-paper-300 bg-paper-100 hover:border-brand-blue hover:bg-blue-50/30 p-5 transition-colors group"
      >
        <span class="text-xs font-bold uppercase tracking-wider text-indigo-800 block mb-1">Lab Analysis</span>
        <h3 class="text-base font-bold text-ink-900 group-hover:text-brand-blue transition-colors flex items-center justify-between">
          <span>System Review</span>
          <span>&rarr;</span>
        </h3>
        <p class="text-xs text-ink-600 mt-2 leading-relaxed">
          Deep dive into multi-model routing, prompt alignment, and MCP developer workflows.
        </p>
      </a>
    </section>

    <!-- Key Takeaway -->
    <KeyTakeaway
      pickA="Everygen AI"
      forScenarioA="integrated multi-model access (Kling 4.0, Seedance 2.5) with native MCP integration"
      pickB="Runway Gen-3 or Luma"
      forScenarioB="dedicated studio tools with custom camera velocity curves"
    />

    <!-- 1. What is Everygen AI? (Core Explainer) -->
    <section class="space-y-4 pt-4">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        What is Everygen AI? (The Viewmax LLC Evolution)
      </h2>
      <div class="space-y-4 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          <strong>Everygen AI</strong> is a multimodal generation platform operated by <strong>Viewmax LLC</strong>. Originally launched under the domain <em>Viewmax AI</em>, the suite was rebranded in late 2026 to reflect its expanded architectural scope: a unified web and API layer combining video generation, image diffusion, and agent interoperability.
        </p>
        <p>
          Rather than training an isolated proprietary diffusion model, Everygen orchestrates top-tier foundational engines. Creators can deploy state-of-the-art models like <strong>Seedance 2.5</strong> (generating continuous 30-second clips at 1080p), <strong>Kling 4.0</strong> (supporting advanced reference-image conditioning), <strong>MiniMax H3 Max</strong>, and <strong>Grok Imagine</strong> within a single interface.
        </p>
      </div>
    </section>

    <!-- 2. Technical Capabilities: 30s 1080p & MCP -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Two Critical Technical Differentiators
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        <div class="space-y-2">
          <h3 class="text-lg font-bold text-ink-900">1. Long-Form 30-Second 1080p Generation</h3>
          <p class="text-sm text-ink-700 leading-relaxed">
            While legacy consumer models were historically locked to 4 or 5-second outputs, Everygen\'s integration of Seedance 2.5 and Kling 4.0 delivers native 30-second sequences with high temporal consistency and 1080p visual fidelity.
          </p>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg font-bold text-ink-900">2. Model Context Protocol (MCP) Interoperability</h3>
          <p class="text-sm text-ink-700 leading-relaxed">
            By exposing native MCP endpoints, Everygen bridges visual AI with agentic developer environments. Teams can prompt, generate, and orchestrate video assets directly inside Cursor, Claude Desktop, or ChatGPT without manual browser copy-pasting.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. Dynamic Pricing & Credit Structure -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Account Quotas & Credit Pricing
      </h2>
      <p class="text-sm text-ink-700 leading-relaxed">
        Generation credit costs vary depending on the chosen model engine (Seedance 2.5 vs Kling 4.0), output length (5s vs 30s), and resolution parameters. Dynamic credit packages and promotional bundles are managed on the official platform.
      </p>

      <div class="rounded-lg bg-paper-100 border border-paper-300 p-5 text-xs text-ink-600 leading-relaxed">
        <strong>Notice:</strong> Always review the active quota balances in your Everygen account dashboard. Our guides focus on architectural compatibility, comparative feature sets, and workflow optimization.
      </div>
    </section>

    <!-- FAQs -->
    <FaqAccordion faqs={faqs} />
  </div>
</BaseLayout>
