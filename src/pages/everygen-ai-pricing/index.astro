---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KeyTakeaway from '../../components/KeyTakeaway.astro';
import FaqAccordion, { type FaqItem } from '../../components/FaqAccordion.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { BUILD_DATE_ISO } from '../../data/quotas';

const title = 'Everygen AI Pricing (2026): Starter $9, Pro $19 & Plans Compared';
const description = 'Official Everygen AI pricing breakdown. Compare Starter ($9/mo, 200 credits), Pro ($19/mo, 500 credits), and Creator ($49/mo), plus model generation costs.';
const canonicalPath = 'everygen-ai-pricing';

const faqs: FaqItem[] = [
  {
    question: 'How much does Everygen AI cost per month?',
    answer:
      'According to official platform pricing, Everygen AI offers three subscription tiers: Starter at $9/mo billed annually (200 credits/mo), Pro at $19/mo (500 credits/mo + 500 bonus credits in month 1), and Creator at $49/mo (1,000 credits/mo + 1,000 bonus credits in month 1).',
  },
  {
    question: 'Can I monetize videos generated with Everygen AI?',
    answer:
      'Yes. Everygen AI explicitly states in its official documentation: "Can I monetize videos made with Everygen? — Yes! without any restrictions." Paid plan subscribers hold full commercial rights to their video outputs.',
  },
  {
    question: 'Do Everygen AI credits roll over to the next month?',
    answer:
      'Subscription plan credits reset monthly and do not roll over. However, standalone on-demand top-up credit packs remain valid for 90 days from the purchase date.',
  },
  {
    question: 'Does Everygen AI have a free plan?',
    answer:
      'Everygen AI does not offer an ongoing permanent free subscription tier. Newly registered accounts receive an initial allocation of 10 promotional credits upon signup, which is below the ~11 credits required for an entry-level fast 5s render (Seedance 2 Fast; higher-quality Standard runs consume ~16.4–19.2 credits per clip), so active video creation begins with the Starter tier from $9/mo.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  author: {
    '@type': 'Person',
    name: 'David Chen',
    url: 'https://videogenreviews.com/author/david-chen/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'VideoGen Reviews',
    url: 'https://videogenreviews.com',
  },
  datePublished: '2026-11-12',
  dateModified: BUILD_DATE_ISO,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://videogenreviews.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Everygen AI Pricing',
      item: 'https://videogenreviews.com/everygen-ai-pricing/',
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  schema={[articleSchema, faqSchema, breadcrumbSchema]}
>
  <Breadcrumbs crumbs={[{ label: 'Everygen AI Pricing' }]} />

  <article class="space-y-10">
    <header class="border-b border-paper-300 pb-8">
      <div class="text-xs font-semibold text-brand-blue uppercase tracking-wider mb-2">
        Official Quota & Subscription Breakdown
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-900 tracking-tight leading-tight mb-4">
        Everygen AI Pricing: Plans, Credits & Rates (2026)
      </h1>

      <p class="text-base sm:text-lg text-ink-700 leading-relaxed max-w-3xl font-normal mb-3">
        A verified breakdown of official Everygen AI subscription plans by Viewmax LLC: comparing Starter ($9/mo), Pro ($19/mo), and Creator ($49/mo), compute credit yields, and commercial usage rights.
      </p>

      <div class="text-xs text-ink-500 font-medium">
        Updated November 13, 2026 &bull; Verified against official everygen.ai/pricing &bull; Written by <a href="/author/david-chen/" class="text-brand-blue font-semibold hover:underline">David Chen</a>
      </div>
    </header>

    <KeyTakeaway
      pickA="Pro Plan ($19/mo)"
      forScenarioA="best value tier with 500 credits + 500 first-month bonus, supporting ~26 clips/month (first month ~52 with the 500-credit bonus)"
      pickB="Starter Plan (From $9/mo)"
      forScenarioB="entry tier for creators testing Seedance and Kling with 200 monthly credits"
      pickC="Creator Plan ($49/mo)"
      forScenarioC="high-volume studio pipelines requiring 1,000 monthly credits + 1,000 bonus credits in month 1"
    />

    <!-- Official Pricing Tiers Table (3 档真实价格) -->
    <section class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
          Official Everygen AI Subscription Tiers
        </h2>
        <span class="text-xs font-medium text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded border border-emerald-200">
          Save up to 64% on annual billing
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        <!-- Starter Plan -->
        <div class="rounded-lg border border-paper-300 bg-paper-100 p-6 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <span class="text-xs uppercase font-bold text-ink-500 tracking-wider">Starter Tier</span>
            <div class="flex items-baseline space-x-1">
              <span class="text-4xl font-extrabold text-ink-900 tracking-tight">$9</span>
              <span class="text-xs text-ink-500 font-medium">/ month</span>
            </div>
            <p class="text-xs text-ink-500">Billed annually ($108/yr; ~$24/mo monthly). Entry plan for indie creators.</p>
            <div class="border-t border-paper-300/80 pt-3 space-y-2 text-xs text-ink-700">
              <div class="flex items-center">
                <span class="font-bold text-ink-900 mr-1.5">200 credits</span> / month
              </div>
              <div>&bull; Approx. ~18 Seedance 2 Fast clips</div>
              <div>&bull; Approx. ~50 Nano Banana Pro images</div>
              <div>&bull; MCP connector (Claude, ChatGPT, Cursor)</div>
              <div>&bull; Commercial monetization rights</div>
            </div>
          </div>
          <a
            href="/go/everygen/"
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            class="w-full inline-flex items-center justify-center px-4 py-2 rounded-md bg-paper-200 hover:bg-paper-300 text-ink-900 font-semibold text-xs transition-colors"
          >
            Select Starter Plan
          </a>
        </div>

        <!-- Pro Plan (Popular) -->
        <div class="rounded-lg border-2 border-brand-blue bg-white p-6 shadow-sm flex flex-col justify-between space-y-4 relative">
          <div class="absolute -top-3 right-4 bg-brand-blue text-white text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full shadow-sm">
            Most Popular
          </div>
          <div class="space-y-2">
            <span class="text-xs uppercase font-bold text-brand-blue tracking-wider">Pro Tier</span>
            <div class="flex items-baseline space-x-2">
              <span class="text-4xl font-extrabold text-ink-900 tracking-tight">$19</span>
              <span class="text-xs text-ink-500 font-medium">/ month</span>
              <span class="text-xs text-ink-400 line-through">$49</span>
            </div>
            <p class="text-xs text-ink-500">Billed annually at $19/mo ($49/mo regular). Recommended for active video creators.</p>
            <div class="border-t border-paper-300/80 pt-3 space-y-2 text-xs text-ink-700">
              <div class="flex items-center font-bold text-brand-blue">
                <span>500 credits / mo + 500 bonus (Month 1)</span>
              </div>
              <div>&bull; Approx. ~26 clips/month (first month ~52 with the 500-credit bonus)</div>
              <div>&bull; Kling 4.0 1080p generation access</div>
              <div>&bull; MCP connector (Claude, ChatGPT, Cursor)</div>
              <div>&bull; High-priority GPU dispatch queue</div>
              <div>&bull; Full commercial license (zero restrictions)</div>
            </div>
          </div>
          <a
            href="/go/everygen/"
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            class="w-full inline-flex items-center justify-center px-4 py-2 rounded-md bg-brand-blue hover:bg-brand-hover text-white font-semibold text-xs transition-colors shadow-sm"
          >
            Select Pro Plan
          </a>
        </div>

        <!-- Creator Plan -->
        <div class="rounded-lg border border-paper-300 bg-paper-100 p-6 flex flex-col justify-between space-y-4">
          <div class="space-y-2">
            <span class="text-xs uppercase font-bold text-purple-700 tracking-wider">Creator Studio</span>
            <div class="flex items-baseline space-x-2">
              <span class="text-4xl font-extrabold text-ink-900 tracking-tight">$49</span>
              <span class="text-xs text-ink-500 font-medium">/ month</span>
              <span class="text-xs text-ink-400 line-through">$139</span>
            </div>
            <p class="text-xs text-ink-500">Billed annually at $49/mo ($139/mo regular). Heavy volume for production studios.</p>
            <div class="border-t border-paper-300/80 pt-3 space-y-2 text-xs text-ink-700">
              <div class="flex items-center font-bold text-purple-900">
                <span>1,000 credits / mo + 1,000 bonus (Month 1)</span>
              </div>
              <div>&bull; Approx. ~61 Seedance 2 clips (official volume tier rate)</div>
              <div>&bull; Maximum priority GPU cluster access</div>
              <div>&bull; Full 30-second continuous 1080p generation</div>
              <div>&bull; MCP connector (Claude, ChatGPT, Cursor)</div>
              <div>&bull; Dedicated customer support queue</div>
            </div>
          </div>
          <a
            href="/go/everygen/"
            target="_blank"
            rel="sponsored nofollow noopener noreferrer"
            class="w-full inline-flex items-center justify-center px-4 py-2 rounded-md bg-paper-200 hover:bg-paper-300 text-ink-900 font-semibold text-xs transition-colors"
          >
            Select Creator Plan
          </a>
        </div>
      </div>
    </section>

    <!-- Commercial License & Credit Rules -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Commercial Rights & Credit Validity Rules
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-sm text-ink-800">
        <div class="p-5 rounded-lg border border-emerald-200 bg-emerald-50/40 space-y-2">
          <h3 class="font-bold text-emerald-900 text-base">
            Can I monetize videos made with Everygen?
          </h3>
          <p class="text-xs sm:text-sm text-emerald-950 leading-relaxed">
            <strong>Yes, without any restrictions.</strong> Everygen AI explicitly confirms in official terms that paid subscribers retain full commercial usage rights for YouTube monetization, client deliverables, advertising campaigns, and social media distributions.
          </p>
        </div>

        <div class="p-5 rounded-lg border border-paper-300 bg-paper-100 space-y-2">
          <h3 class="font-bold text-ink-900 text-base">
            Credit Expiration & Top-Up Packs
          </h3>
          <p class="text-xs sm:text-sm text-ink-700 leading-relaxed">
            Monthly plan credits reset at the start of each billing cycle and do not roll over. However, users who purchase standalone credit refill packs enjoy a <strong>90-day validity window</strong> to consume their credits across supported models.
          </p>
        </div>
      </div>
    </section>

    <!-- Model Yield Table (Seedance, Kling, MiniMax) -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Estimated Video Generation Yield by Model
      </h2>
      <p class="text-sm text-ink-700 leading-relaxed">
        Estimated output volume across Everygen's integrated foundational engines:
      </p>

      <div class="overflow-x-auto rounded-lg border border-paper-300 mt-4">
        <table class="min-w-full divide-y divide-paper-300 text-left text-xs sm:text-sm">
          <thead class="bg-paper-100 font-semibold text-ink-900">
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3">Foundational Engine</th>
              <th scope="col" class="px-3 py-3.5">Duration</th>
              <th scope="col" class="px-3 py-3.5">200 Credits (Starter)</th>
              <th scope="col" class="px-3 py-3.5">500 Credits (Pro)</th>
              <th scope="col" class="px-3 py-3.5 pr-4">1,000 Credits (Creator)</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-paper-300 bg-white text-ink-700">
            <tr>
              <td class="py-3.5 pl-4 pr-3 font-semibold text-ink-900">Seedance 2 Fast</td>
              <td class="px-3 py-3.5">5 seconds</td>
              <td class="px-3 py-3.5 text-brand-blue font-medium">~18 clips (~11.1 credits/clip)</td>
              <td class="px-3 py-3.5 text-brand-blue font-medium">~45 clips (est.)</td>
              <td class="px-3 py-3.5 pr-4 text-brand-blue font-medium">~90 clips (est.)</td>
            </tr>
            <tr>
              <td class="py-3.5 pl-4 pr-3 font-semibold text-ink-900">Seedance 2 (Standard)</td>
              <td class="px-3 py-3.5">5 seconds</td>
              <td class="px-3 py-3.5 text-brand-blue font-medium">~10 clips (est.)</td>
              <td class="px-3 py-3.5 text-brand-blue font-medium">~26 clips (~19.2 credits/clip)</td>
              <td class="px-3 py-3.5 pr-4 text-brand-blue font-medium">~61 clips (~16.4 credits/clip)</td>
            </tr>
            <tr>
              <td class="py-3.5 pl-4 pr-3 font-semibold text-ink-900">Seedance 2.5 (1080p)</td>
              <td class="px-3 py-3.5">30 seconds continuous</td>
              <td class="px-3 py-3.5 font-medium">~2 to 3 long takes (est.)</td>
              <td class="px-3 py-3.5 font-medium">~6 to 8 long takes (est.)</td>
              <td class="px-3 py-3.5 pr-4 font-medium">~12 to 16 long takes (est.)</td>
            </tr>
            <tr>
              <td class="py-3.5 pl-4 pr-3 font-semibold text-ink-900">Kling AI 4.0 / 3.0</td>
              <td class="px-3 py-3.5">5s - 10s</td>
              <td class="px-3 py-3.5 font-medium">~5 to 7 clips (est.)</td>
              <td class="px-3 py-3.5 font-medium">~14 to 16 clips (est.)</td>
              <td class="px-3 py-3.5 pr-4 font-medium">~28 to 33 clips (est.)</td>
            </tr>
            <tr>
              <td class="py-3.5 pl-4 pr-3 font-semibold text-ink-900">Nano Banana Pro</td>
              <td class="px-3 py-3.5">Still Frame</td>
              <td class="px-3 py-3.5 font-medium">~50 images</td>
              <td class="px-3 py-3.5 font-medium">~125 images</td>
              <td class="px-3 py-3.5 pr-4 font-medium">~250 images</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="text-xs text-ink-500 mt-2 leading-relaxed">
        * Note: Yield figures for Seedance 2 Fast (18 clips on Starter, ~11.1 credits/clip) and Seedance 2 Standard (26 clips on Pro at ~19.2 credits/clip; 61 clips on Creator at ~16.4 credits/clip) reflect published official Everygen tier allocations—higher-tier Creator plans include an official ~15% per-clip volume discount. First-month Pro and Creator bonuses double initial monthly yields. Long-form continuous 30-second generations are estimated based on credit duration multipliers. Kling AI standalone accounts replenish 66 daily credits under Kling's native platform economy (~30–35 credits per 5s generation), which cannot be directly converted to Everygen account credits.
      </p>
    </section>

    <!-- Navigation Hub -->
    <section class="rounded-lg bg-paper-100 border border-paper-300 p-6 sm:p-8 space-y-3">
      <h2 class="text-lg font-bold text-ink-900">Compare Alternatives & Free Trial Rules</h2>
      <p class="text-sm text-ink-700 leading-relaxed">
        Seeking free daily credits instead of a paid monthly plan? Read our <a href="/is-everygen-ai-free/" class="text-brand-blue font-semibold hover:underline">Free Trial & Quotas Guide</a>, compare <a href="/everygen-ai-alternatives/" class="text-brand-blue font-semibold hover:underline">10 Top Video Alternatives</a>, or examine our <a href="/methodology/" class="text-brand-blue font-semibold hover:underline">5-Criteria Evaluation Methodology</a>.
      </p>
    </section>

    <!-- FAQs -->
    <FaqAccordion faqs={faqs} />
  </article>
</BaseLayout>
