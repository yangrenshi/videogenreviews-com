---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { PAGE_DATES } from '../../data/quotas';

const title = 'Editorial Team & Standards | VideoGen Reviews';
const description = 'Meet the VideoGen Reviews Editorial Team. Specification-grounded research, documented specification analysis, and transparent evaluation standards for generative video tools.';
const canonicalPath = 'editorial-team';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'VideoGen Reviews Editorial Team',
  url: 'https://videogenreviews.com/editorial-team/',
  parentOrganization: {
    '@type': 'Organization',
    name: 'VideoGen Reviews',
    url: 'https://videogenreviews.com',
  },
  description: 'Specialists in diffusion architecture benchmarking, pricing schedule tracking, and commercial video generation workflows.',
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  schema={organizationSchema}
>
  <Breadcrumbs crumbs={[{ label: 'Editorial Team' }]} />

  <article class="space-y-10">
    <!-- Header -->
    <header class="border-b border-paper-300 pb-8 flex flex-col sm:flex-row items-start sm:items-center gap-6">
      <div class="w-20 h-20 rounded-full bg-brand-blue text-white flex items-center justify-center font-bold text-xl shadow-sm shrink-0 tracking-wider">
        VGR
      </div>
      <div>
        <div class="text-xs font-semibold text-brand-blue uppercase tracking-wider mb-1">
          Editorial Desk
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-ink-900 tracking-tight">
          VideoGen Reviews Editorial Team
        </h1>
        <div class="text-xs text-ink-500 font-medium mt-1">
          Updated {PAGE_DATES.editorialTeam.display} &bull; Research &amp; Methodology Desk
        </div>
        <p class="text-sm text-ink-600 mt-2 max-w-2xl leading-relaxed">
          Tracking the evolution of video diffusion models from early short-clip research checkpoints to commercial 30-second 1080p generative production engines.
        </p>
      </div>
    </header>

    <!-- Scope & Focus -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-ink-900 tracking-tight">
        Editorial Scope &amp; Technical Focus
      </h2>
      <div class="space-y-3 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          The VideoGen Reviews Editorial Team directs technical coverage and comparative benchmark specifications across generative visual software. Our research focuses on diffusion transformer architectures, prompt fidelity, parameter controls, and compute economics.
        </p>
        <p>
          Our technical analysis examines foundational generative media engines—including the video engines Seedance 2.5, Kling 4.0, MiniMax H3 Max, Grok Imagine, and Gemini Omni 1.1 Flash, plus the still-image model Nano Banana Pro—evaluating how modern routing aggregators (such as Everygen AI) compare against dedicated standalone platforms like Runway Gen-4.5 and PixVerse V6.
        </p>
      </div>
    </section>

    <!-- Evaluation Standard: Strict Alignment with Methodology -->
    <section class="space-y-4 border-t border-paper-300 pt-6">
      <h2 class="text-xl font-bold text-ink-900 tracking-tight">
        How We Evaluate Generative Video Tools
      </h2>
      <div class="space-y-3 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          To maintain strict analytical honesty and prevent misleading claims, our content is grounded in officially published documentation, public developer APIs, and official high-resolution reference releases. We cross-reference commercial licensing terms, continuous duration capabilities, and credit burn schedules directly against vendor specifications.
        </p>
        <p class="p-4 rounded-lg border border-paper-300 bg-paper-100 text-xs sm:text-sm text-ink-700">
          <strong>Testing &amp; Methodology Standards:</strong> In full alignment with our <a href="/methodology/" class="text-brand-blue font-semibold hover:underline">Evaluation Methodology</a>, our scores and comparisons are derived from standardized prompt scenarios evaluated against official high-resolution reference releases and published technical specifications; we do not claim independent in-house rendering tests.
        </p>
      </div>
    </section>

    <!-- Our 5-Criteria Evaluation Framework -->
    <section class="rounded-lg border border-paper-300 bg-paper-100 p-6 sm:p-8 space-y-4">
      <h2 class="text-lg font-bold text-ink-900">
        Our Core 5-Criteria Evaluation Framework
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-ink-700">
        <div class="border-l-2 border-brand-blue pl-3 space-y-1">
          <strong class="text-ink-900 block">1. Prompt Adherence (25% Weight)</strong>
          <span>How faithfully does the synthesis engine adhere to subject positioning, lighting cues, and directional verbs without hallucinating artifacts?</span>
        </div>
        <div class="border-l-2 border-brand-blue pl-3 space-y-1">
          <strong class="text-ink-900 block">2. Temporal Consistency (25% Weight)</strong>
          <span>Does the scene maintain character facial anatomy, background architectural lines, and mass stability across continuous multi-second generations?</span>
        </div>
        <div class="border-l-2 border-brand-blue pl-3 space-y-1">
          <strong class="text-ink-900 block">3. Visual Fidelity (20% Weight)</strong>
          <span>Evaluation of texture realism, dynamic lighting range, and prevention of artificial plastic gloss or compression banding.</span>
        </div>
        <div class="border-l-2 border-brand-blue pl-3 space-y-1">
          <strong class="text-ink-900 block">4. Motion Quality &amp; Biomechanics (15% Weight)</strong>
          <span>Assesses whether movement conforms to real-world physics: gravity, momentum, natural footstep friction against ground surfaces, limb continuity, and fluid dynamics.</span>
        </div>
        <div class="border-l-2 border-brand-blue pl-3 space-y-1 sm:col-span-2">
          <strong class="text-ink-900 block">5. Compute Credit Value &amp; Pricing Transparency (15% Weight)</strong>
          <span>Measuring real cost per usable commercial second, recurring daily refill allowances, and transparency of pricing bundles.</span>
        </div>
      </div>
    </section>

    <!-- Editorial Independence & Disclosure -->
    <section class="border-t border-paper-300 pt-6 space-y-3 text-xs text-ink-600 leading-relaxed">
      <h3 class="font-bold text-ink-800 uppercase tracking-wider text-xs">
        Editorial Independence &amp; Disclosure
      </h3>
      <p>
        All evaluations published by the VideoGen Reviews Editorial Team are produced independently. While we may receive affiliate referral compensation from select partners when readers register through tracked links, commercial partnerships never dictate editorial rankings, score adjustments, or critical omissions. Read our complete <a href="/affiliate-disclosure/" class="text-brand-blue font-semibold hover:underline">Affiliate Disclosure</a> for full details.
      </p>
    </section>
  </article>
</BaseLayout>
