---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = 'Privacy Policy | VideoGen Reviews';
const description = 'Privacy policy for VideoGen Reviews explaining data collection, analytics, and cookie practices.';
const canonicalPath = 'privacy-policy';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <Breadcrumbs crumbs={[{ label: 'Privacy Policy' }]} />

  <article class="max-w-3xl space-y-8">
    <header class="border-b border-paper-300 pb-6">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-900 tracking-tight leading-tight mb-3">
        Privacy Policy
      </h1>
      <p class="text-xs text-ink-500 font-medium">
        Last updated: November 2026
      </p>
    </header>

    <section class="space-y-4 text-sm sm:text-base text-ink-800 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-ink-900">1. Information We Collect</h2>
      <p>
        VideoGen Reviews is an informational review portal. We do not require account registration or collect personal names, passwords, or credit card details on this site.
      </p>
      <p>
        Like most websites, we use standard server logs and privacy-preserving web analytics to monitor aggregate page views, referrer origins, and browser technology to improve site performance.
      </p>
    </section>

    <section class="space-y-4 text-sm sm:text-base text-ink-800 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-ink-900">2. Cookies & Third-Party Links</h2>
      <p>
        When you click external links to generative AI tools, those third-party services may place cookies to track referral attribution. We encourage you to review the privacy policies of any external websites you visit.
      </p>
    </section>

    <section class="space-y-4 text-sm sm:text-base text-ink-800 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-ink-900">3. Contact Us</h2>
      <p>
        If you have questions regarding this Privacy Policy, please reach out via our <a href="/contact/" class="text-brand-blue font-semibold hover:underline">Contact page</a>.
      </p>
    </section>
  </article>
</BaseLayout>
