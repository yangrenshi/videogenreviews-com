---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { PAGE_DATES } from '../../../data/quotas';

const title = 'David Chen - Lead Video AI Research Analyst | VideoGen Reviews';
const description = 'David Chen leads editorial research and benchmark methodology at VideoGen Reviews, evaluating diffusion models, temporal consistency, and commercial production pipelines.';
const canonicalPath = 'author/david-chen';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'David Chen',
  jobTitle: 'Lead Generative Video Analyst',
  worksFor: {
    '@type': 'Organization',
    name: 'VideoGen Reviews',
    url: 'https://videogenreviews.com',
  },
  description: 'Specialist in generative diffusion architectures, temporal coherence evaluation, and generative VFX production tooling.',
  datePublished: '2026-11-12',
  dateModified: PAGE_DATES.authorDavidChen.iso,
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  schema={personSchema}
>
  <Breadcrumbs crumbs={[{ label: 'Editorial Team' }, { label: 'David Chen' }]} />

  <article class="space-y-10">
    <!-- Author Header -->
    <header class="border-b border-paper-300 pb-8 flex flex-col sm:flex-row items-start sm:items-center gap-6">
      <div class="w-20 h-20 rounded-full bg-brand-blue text-white flex items-center justify-center font-bold text-2xl shadow-sm shrink-0">
        DC
      </div>
      <div>
        <div class="text-xs font-semibold text-brand-blue uppercase tracking-wider mb-1">
          Lead Generative Video Analyst
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-ink-900 tracking-tight">
          David Chen
        </h1>
        <div class="text-xs text-ink-500 font-medium mt-1">
          Profile Updated {PAGE_DATES.authorDavidChen.display} &bull; Editorial Lead at VideoGen Reviews
        </div>
        <p class="text-sm text-ink-600 mt-2 max-w-2xl leading-relaxed">
          Tracking the rapid evolution of video diffusion models from early 4-second research checkpoints to commercial 30-second 1080p generative production engines.
        </p>
      </div>
    </header>

    <!-- Editorial Scope & Technical Focus -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-ink-900 tracking-tight">
        Editorial Scope &amp; Technical Focus
      </h2>
      <div class="space-y-3 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          David Chen directs technical editorial coverage and comparative benchmark specifications at VideoGen Reviews, with a focus on generative diffusion architectures, temporal coherence evaluation, and production workflow tooling.
        </p>
        <p>
          His analysis examines the operational capabilities and unit economics of foundational video engines—including Seedance 2.5, Kling 4.0, MiniMax H3 Max, Grok Imagine, Nano Banana Pro, and Gemini Omni 1.1 Flash—evaluating how modern routing aggregators compare against dedicated web portals like Runway Gen-4.5 and PixVerse.
        </p>
      </div>
    </section>

    <!-- Editorial Philosophy & Evaluation Standards -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-ink-900 tracking-tight">
        Editorial Philosophy &amp; Evaluation Standards
      </h2>
      <div class="space-y-4 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          At VideoGen Reviews, our mission is to eliminate marketing hyperbole and provide creators, video editors, and engineering teams with specification-grounded evaluations of generative visual software.
        </p>
        <p>
          David focuses on the technical intersection between diffusion transformers, prompt fidelity, and real compute economics. As platforms migrate toward multi-model routing architectures like Everygen AI, our team assesses both centralized aggregators and dedicated standalone software like Kling AI, Runway, and PixVerse.
        </p>
      </div>
    </section>

    <!-- How We Evaluate Section -->
    <section class="space-y-4 border-t border-paper-300 pt-6">
      <h2 class="text-xl font-bold text-ink-900 tracking-tight">
        How We Evaluate Generative Video Tools
      </h2>
      <div class="space-y-3 text-ink-800 text-sm sm:text-base leading-relaxed">
        <p>
          Our evaluations synthesize data from officially published technical documentation, public API documentation, standardized prompt scenarios, and officially released high-resolution reference outputs. We cross-reference commercial licensing tiers against official vendor pages, continuous duration limits, audio generation capabilities, and credit burn schedules against current production standards.
        </p>
        <p>
          Pricing and quota analyses reflect live tier schedules and official credit top-up ratios published on official vendor sites. Rather than relying on subjective anecdotal impressions or marketing claims, our structured criteria benchmark platforms on model breadth, parameter control, developer protocol access (such as MCP), and compute cost efficiency.
        </p>
      </div>
    </section>

    <!-- Our 5-Criteria Evaluation Framework -->
    <section class="rounded-lg border border-paper-300 bg-paper-100 p-6 sm:p-8 space-y-4">
      <h2 class="text-lg font-bold text-ink-900">
        Our Core 5-Criteria Evaluation Framework
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm text-ink-700">
        <div class="border-l-2 border-brand-blue pl-3 space-y-1">
          <strong class="text-ink-900 block">1. Prompt Adherence (25% Weight)</strong>
          <span>How faithfully does the synthesis engine adhere to subject positioning, lighting cues, and directional verbs without hallucinating artifacts?</span>
        </div>
        <div class="border-l-2 border-brand-blue pl-3 space-y-1">
          <strong class="text-ink-900 block">2. Temporal Consistency (25% Weight)</strong>
          <span>Does the scene maintain character facial anatomy, background architectural lines, and mass stability across continuous multi-second generations?</span>
        </div>
        <div class="border-l-2 border-brand-blue pl-3 space-y-1">
          <strong class="text-ink-900 block">3. Visual Fidelity (20% Weight)</strong>
          <span>Evaluation of texture realism, dynamic lighting range, and prevention of artificial plastic gloss or compression banding.</span>
        </div>
        <div class="border-l-2 border-brand-blue pl-3 space-y-1">
          <strong class="text-ink-900 block">4. Motion Quality & Biomechanics (15% Weight)</strong>
          <span>Assesses whether movement conforms to real-world physics: gravity, momentum, natural footstep friction against ground surfaces, limb continuity, and fluid dynamics.</span>
        </div>
        <div class="border-l-2 border-brand-blue pl-3 space-y-1 sm:col-span-2">
          <strong class="text-ink-900 block">5. Compute Credit Value & Pricing Transparency (15% Weight)</strong>
          <span>Measuring real cost per usable commercial second, recurring daily refill allowances, and transparency of pricing bundles.</span>
        </div>
      </div>
    </section>

    <!-- Transparency & Conflict of Interest Statement -->
    <section class="border-t border-paper-300 pt-6 space-y-3 text-xs text-ink-600 leading-relaxed">
      <h3 class="font-bold text-ink-800 uppercase tracking-wider text-xs">
        Editorial Independence & Disclosure
      </h3>
      <p>
        All evaluations published by David Chen and the VideoGen Reviews team are produced independently. While we may receive affiliate referral compensation from select partners when readers register through tracked links, commercial partnerships never dictate editorial rankings, score adjustments, or critical omissions.
      </p>
    </section>
  </article>
</BaseLayout>
