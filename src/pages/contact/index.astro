---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = 'Contact & Corrections | VideoGen Reviews';
const description = 'Contact the editorial team at VideoGen Reviews for questions, data corrections, and partnership inquiries.';
const canonicalPath = 'contact';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <Breadcrumbs crumbs={[{ label: 'Contact Us' }]} />

  <article class="max-w-3xl space-y-8">
    <header class="border-b border-paper-300 pb-6">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-900 tracking-tight leading-tight mb-3">
        Contact & Corrections
      </h1>
      <p class="text-base text-ink-700 leading-relaxed font-normal">
        Found an outdated model parameter, rebrand update, or change in pricing? Let us know.
      </p>
    </header>

    <section class="space-y-4 text-sm sm:text-base text-ink-800 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-ink-900">Editorial Corrections</h2>
      <p>
        AI generative video engines adjust parameters frequently. If an engine has updated its max clip duration, introduced new foundational weights, or modified subscription credit pools, please provide the official announcement link and documentation.
      </p>
    </section>

    <section class="rounded-lg border border-paper-300 bg-paper-100 p-6 space-y-3">
      <h3 class="text-base font-bold text-ink-900">Direct Inquiries</h3>
      <p class="text-xs text-ink-600">
        You can reach our editorial and research desk at:
      </p>
      <div class="text-sm font-semibold text-brand-blue">
        editorial@videogenreviews.com
      </div>
    </section>
  </article>
</BaseLayout>
