---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = 'Contact & Corrections | VideoGen Reviews';
const description = 'Contact the editorial team at VideoGen Reviews for questions, data corrections, and partnership inquiries.';
const canonicalPath = 'contact';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <Breadcrumbs crumbs={[{ label: 'Contact Us' }]} />

  <article class="max-w-3xl space-y-8">
    <header class="border-b border-white/[0.08] pb-6">
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight font-display mb-3">
        Contact & Corrections
      </h1>
      <p class="text-base text-slate-300 leading-relaxed font-medium">
        Found an outdated model parameter, rebrand update, or change in pricing? Let us know.
      </p>
    </header>

    <section class="space-y-4 text-sm sm:text-base text-slate-300 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-white font-display">Editorial Corrections</h2>
      <p>
        AI generative video engines adjust parameters frequently. If an engine has updated its max clip duration, introduced new foundational weights, or modified subscription credit pools, please provide the official announcement link and documentation.
      </p>
    </section>

    <section class="rounded-2xl border border-white/[0.08] bg-dark-900/60 p-6 space-y-3">
      <h3 class="text-base font-bold text-white font-display">Direct Inquiries</h3>
      <p class="text-xs text-slate-400">
        You can reach our editorial and research desk at:
      </p>
      <div class="text-sm font-mono text-sky-400 font-bold">
        editorial@videogenreviews.com
      </div>
    </section>
  </article>
</BaseLayout>
