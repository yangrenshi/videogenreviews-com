---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = 'About VideoGen Reviews: Editorial Standards & Methodology';
const description = 'Learn about VideoGen Reviews, our independent editorial methodology, and how we compare generative AI video models and tools.';
const canonicalPath = 'about';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <Breadcrumbs crumbs={[{ label: 'About Us' }]} />

  <article class="max-w-3xl space-y-8">
    <header class="border-b border-white/[0.08] pb-6">
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight font-display mb-3">
        About VideoGen Reviews
      </h1>
      <p class="text-base text-slate-300 leading-relaxed font-medium">
        Empowering digital video creators, filmmakers, and marketers with transparent, hype-free comparisons of modern generative video engines.
      </p>
    </header>

    <section class="space-y-4 text-sm sm:text-base text-slate-300 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-white font-display">Our Mission</h2>
      <p>
        The generative video space is evolving at an unprecedented pace. New models, rebranded platforms, and token economics emerge weekly. At <strong>VideoGen Reviews</strong>, our goal is simple: decode platform specifications, clarify model routing architectures, and document the actual limitations that marketing landing pages obscure.
      </p>
    </section>

    <section class="space-y-4 text-sm sm:text-base text-slate-300 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-white font-display">Editorial Independence</h2>
      <p>
        We are an independent publication. We do not accept paid placements to inflate rankings. When we evaluate an engine—whether it is Kling, Seedance, Runway, Luma, or Everygen AI—we analyze its published capabilities, user reports, and technical documentation side by side.
      </p>
    </section>

    <section class="space-y-4 text-sm sm:text-base text-slate-300 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-white font-display">How We Are Funded</h2>
      <p>
        To keep our content free of paywalls, we participate in affiliate programs. If you click on an external link to a video tool and subscribe, we may receive a commission at zero additional cost to you. Read our full <a href="/affiliate-disclosure/" class="text-sky-400 hover:underline">Affiliate Disclosure</a> for details.
      </p>
    </section>
  </article>
</BaseLayout>
