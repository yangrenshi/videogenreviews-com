---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const title = 'About VideoGen Reviews: Editorial Standards & Methodology';
const description = 'Learn about VideoGen Reviews, our independent editorial methodology, and how we compare generative AI video models and tools.';
const canonicalPath = 'about';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
>
  <Breadcrumbs crumbs={[{ label: 'About Us' }]} />

  <article class="max-w-3xl space-y-8">
    <header class="border-b border-paper-300 pb-6">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-900 tracking-tight leading-tight mb-3">
        About VideoGen Reviews
      </h1>
      <p class="text-base text-ink-700 leading-relaxed font-normal">
        Empowering digital video creators, filmmakers, and marketers with transparent, hype-free comparisons of modern generative video engines.
      </p>
    </header>

    <section class="space-y-4 text-sm sm:text-base text-ink-800 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-ink-900">Our Mission</h2>
      <p>
        The generative video space is evolving at an unprecedented pace. New models, rebranded platforms, and token economics emerge weekly. At <strong>VideoGen Reviews</strong>, our goal is simple: decode platform specifications, clarify model routing architectures, and document the actual limitations that marketing landing pages obscure.
      </p>
    </section>

    <section class="space-y-4 text-sm sm:text-base text-ink-800 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-ink-900">Editorial Independence</h2>
      <p>
        We are an independent publication. We do not accept paid placements to inflate rankings. When we evaluate an engine—whether it is Kling, Seedance, Runway, Luma, or Everygen AI—we analyze its published capabilities, official changelogs, and technical documentation side by side. Explore our <a href="/methodology/" class="text-brand-blue font-semibold hover:underline">5-Criteria Evaluation Methodology</a> for full weighting and scoring details.
      </p>
    </section>

    <section class="space-y-4 text-sm sm:text-base text-ink-800 leading-relaxed">
      <h2 class="text-xl sm:text-2xl font-bold text-ink-900">How We Are Funded</h2>
      <p>
        To keep our content free of paywalls, we participate in affiliate programs. If you click on an external link to a video tool and subscribe, we may receive a commission at zero additional cost to you. Read our full <a href="/affiliate-disclosure/" class="text-brand-blue font-semibold hover:underline">Affiliate Disclosure</a> for details.
      </p>
    </section>
  </article>
</BaseLayout>
