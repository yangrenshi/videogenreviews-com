---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KeyTakeaway from '../../components/KeyTakeaway.astro';
import FaqAccordion, { type FaqItem } from '../../components/FaqAccordion.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { TOOLS_DATA, PAGE_DATES } from '../../data/quotas';

const title = 'Everygen AI vs Runway (2026): Which Fits Your Video Workflow';
const description =
  'Everygen AI vs Runway Gen-4.5 compared. Multi-model credit aggregation and 30s takes vs studio-grade motion brushes and keyframe trajectory control.';
const canonicalPath = 'everygen-ai-vs-runway';

const faqs: FaqItem[] = [
  {
    question: 'How do Everygen AI and Runway differ in core focus?',
    answer:
      'Everygen AI is a multi-engine hub routing generations across 6 models (including Seedance 2.5 and Kling 4.0) with developer MCP support. Runway focuses on professional VFX post-production, offering motion brush keyframing, multi-brush regional steering, and cinematic timeline controls in its Gen-4.5 interface.',
  },
  {
    question: 'How much does Runway cost compared to Everygen AI?',
    answer:
      'Everygen AI plans start at $24/month ($9/month billed annually) for ~200 multi-model credits. Runway plans start with a one-time 125-credit trial upon registration, with paid Standard tiers beginning at $15/month ($12/month annual) for 625 monthly credits.',
  },
  {
    question: 'Can Runway generate continuous 30-second videos like Everygen?',
    answer:
      'No. Runway Gen-4.5 typically generates video in 5 to 10-second segments that require manual timeline extension and stitching, whereas Everygen generates continuous 30-second single-take sequences at native 1080p via its Seedance 2.5 engine.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: description,
  author: {
    '@type': 'Organization',
    name: 'VideoGen Reviews Editorial Team',
    url: 'https://videogenreviews.com/editorial-team/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'VideoGen Reviews',
    url: 'https://videogenreviews.com',
  },
  datePublished: '2026-11-24',
  dateModified: PAGE_DATES.vsRunway.iso,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://videogenreviews.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Alternatives',
      item: 'https://videogenreviews.com/everygen-ai-alternatives/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Everygen AI vs Runway',
      item: 'https://videogenreviews.com/everygen-ai-vs-runway/',
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  schema={[articleSchema, faqSchema, breadcrumbSchema]}
>
  <Breadcrumbs
    crumbs={[
      { label: 'Alternatives', href: '/everygen-ai-alternatives/' },
      { label: 'Everygen vs Runway' },
    ]}
  />

  <article class="space-y-10">
    <header class="border-b border-paper-300 pb-8">
      <div class="text-xs font-semibold text-brand-blue uppercase tracking-wider mb-2">
        Platform Head-to-Head Comparison
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-ink-900 tracking-tight leading-tight mb-4">
        Everygen AI vs Runway
      </h1>

      <p class="text-base sm:text-lg text-ink-700 leading-relaxed max-w-3xl font-normal mb-3">
        Comparing unified multi-engine generative hubs against studio-grade visual effects timelines. An analysis of camera brushes, duration capabilities, and production costs.
      </p>

      <div class="text-xs text-ink-500 font-medium">
        Updated {PAGE_DATES.vsRunway.display} &bull; Cross-referenced with official pricing pages on 2026-11-23 &bull; Written by <a href="/editorial-team/" class="text-brand-blue font-semibold hover:underline">VideoGen Reviews Editorial Team</a>
      </div>
    </header>

    <KeyTakeaway
      pickA="Everygen AI (Score: 8.4/10)"
      forScenarioA="continuous 30-second 1080p single takes (Seedance 2.5), multi-model credit pooling, and programmatic MCP automation"
      pickB="Runway Gen-4.5 (Score: 8.0/10)"
      forScenarioB="advanced motion brush controls, multi-layer VFX steering, and timeline-based camera velocity keyframing"
    />

    <!-- Comparison Summary Table -->
    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Core Specifications at a Glance
      </h2>
      <div class="overflow-x-auto rounded-lg border border-paper-300">
        <table class="min-w-full divide-y divide-paper-300 text-left text-xs sm:text-sm">
          <thead class="bg-paper-100 font-semibold text-ink-900">
            <tr>
              <th scope="col" class="py-3.5 pl-4 pr-3">Feature</th>
              <th scope="col" class="px-3 py-3.5 text-brand-blue">Everygen AI</th>
              <th scope="col" class="px-3 py-3.5 text-indigo-900">Runway Gen-4.5</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-paper-300 bg-white text-ink-700">
            <tr>
              <td class="py-3 pl-4 pr-3 font-semibold text-ink-900">Platform Category</td>
              <td class="px-3 py-3">Multi-engine aggregator &amp; MCP router</td>
              <td class="px-3 py-3">Creative studio &amp; VFX video timeline</td>
            </tr>
            <tr>
              <td class="py-3 pl-4 pr-3 font-semibold text-ink-900">Benchmark Score</td>
              <td class="px-3 py-3 font-bold text-ink-900">{TOOLS_DATA.everygen.totalScore} / 10</td>
              <td class="px-3 py-3 font-bold text-ink-900">{TOOLS_DATA.runway.totalScore} / 10</td>
            </tr>
            <tr>
              <td class="py-3 pl-4 pr-3 font-semibold text-ink-900">Starting Price</td>
              <td class="px-3 py-3">{TOOLS_DATA.everygen.startingPrice}</td>
              <td class="px-3 py-3">{TOOLS_DATA.runway.startingPrice}</td>
            </tr>
            <tr>
              <td class="py-3 pl-4 pr-3 font-semibold text-ink-900">Free Tier Allowance</td>
              <td class="px-3 py-3">{TOOLS_DATA.everygen.freeTierSummary}</td>
              <td class="px-3 py-3 text-ink-700">{TOOLS_DATA.runway.freeTierSummary}</td>
            </tr>
            <tr>
              <td class="py-3 pl-4 pr-3 font-semibold text-ink-900">Continuous Duration</td>
              <td class="px-3 py-3 font-medium text-emerald-800">{TOOLS_DATA.everygen.maxDuration}</td>
              <td class="px-3 py-3">{TOOLS_DATA.runway.maxDuration}</td>
            </tr>
            <tr>
              <td class="py-3 pl-4 pr-3 font-semibold text-ink-900">Motion Control Tools</td>
              <td class="px-3 py-3">Prompt &amp; reference image conditioning</td>
              <td class="px-3 py-3 text-indigo-900 font-semibold">Motion Brush, Camera Path &amp; Multi-layer VFX</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Pricing & Credits Comparison -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Pricing &amp; Subscription Costs Compared
      </h2>
      <div class="space-y-4 text-sm sm:text-base text-ink-800 leading-relaxed">
        <p>
          Both tools utilize proprietary credit economies, but address distinct user budgets:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
          <div class="p-5 rounded-lg border border-paper-300 bg-paper-100 space-y-2">
            <h3 class="font-bold text-ink-900 text-base">Everygen AI Subscription Rates</h3>
            <p class="text-xs sm:text-sm text-ink-700 leading-relaxed">
              Everygen plans start from $24/month ($9/month billed annually) for ~200 credits, Pro at $49/mo ($19/mo annual) for ~500 credits, and Creator at $139/mo ($49/mo annual) for ~1,000 credits. Promotional trial accounts receive 10 credits upon registration, but require a paid subscription to render full 5-second or 30-second takes.
            </p>
          </div>
          <div class="p-5 rounded-lg border border-paper-300 bg-paper-100 space-y-2">
            <h3 class="font-bold text-ink-900 text-base">Runway Pricing Tiers</h3>
            <p class="text-xs sm:text-sm text-ink-700 leading-relaxed">
              Runway provides 125 free one-time credits upon signup. Ongoing subscriptions start on the Standard plan at $15/user/month ($12/user/month billed annually at $144/year) for 625 credits per month, with Pro at $35/mo ($28/mo annual) for 2,250 credits and custom team workspaces.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Camera Controls vs Duration -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Workflow Strengths: Camera Control vs Continuous Duration
      </h2>
      <div class="space-y-3 text-sm text-ink-800 leading-relaxed">
        <p>
          <strong>Runway's VFX Advantage:</strong> Runway Gen-4.5 excels in micro-level directorial precision. Its motion brush system enables animators to isolate up to five regions in an image, assigning distinct motion velocities, horizontal pans, and zoom trajectories to individual characters or atmospheric smoke.
        </p>
        <p>
          <strong>Everygen's Narrative Duration Advantage:</strong> While Runway is limited to 5–10 second shots that require multi-step video concatenation, Everygen's integration of Seedance 2.5 enables native 30-second takes at 1080p resolution, preserving character clothing consistency and background geometry without sudden scene resets.
        </p>
      </div>
    </section>

    <!-- Which Tool Should You Choose? -->
    <section class="space-y-4 pt-6 border-t border-paper-300">
      <h2 class="text-2xl font-bold text-ink-900 tracking-tight">
        Which Tool Should You Choose?
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="p-4 rounded-lg border border-brand-blue/30 bg-blue-50/20 space-y-2">
          <strong class="text-brand-blue block text-sm">Choose Everygen AI if:</strong>
          <ul class="list-disc list-inside space-y-1 text-ink-700">
            <li>You need sustained 30-second continuous scenes without manual stitching</li>
            <li>You want access to multiple model backends (Seedance, Kling 4.0, MiniMax H3 Max) in one place</li>
            <li>You develop automated production pipelines via Model Context Protocol (MCP)</li>
          </ul>
        </div>
        <div class="p-4 rounded-lg border border-indigo-200 bg-indigo-50/20 space-y-2">
          <strong class="text-indigo-900 block text-sm">Choose Runway if:</strong>
          <ul class="list-disc list-inside space-y-1 text-ink-700">
            <li>You need granular brush control over individual moving objects and camera paths</li>
            <li>You produce professional studio commercial assets requiring video inpainting</li>
            <li>You prefer a dedicated video editor timeline interface</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Navigation & Related -->
    <section class="rounded-lg bg-paper-100 border border-paper-300 p-6 space-y-3">
      <h2 class="text-lg font-bold text-ink-900">Related Everygen AI Guides</h2>
      <p class="text-sm text-ink-700 leading-relaxed">
        Compare other tools in our <a href="/everygen-ai-vs-kling/" class="text-brand-blue font-semibold hover:underline">Everygen AI vs Kling AI comparison</a>, evaluate all top platforms in our <a href="/everygen-ai-alternatives/" class="text-brand-blue font-semibold hover:underline">10 Best Alternatives Guide</a>, or examine plan details in <a href="/everygen-ai-pricing/" class="text-brand-blue font-semibold hover:underline">Everygen AI Pricing</a>.
      </p>
    </section>

    <FaqAccordion faqs={faqs} />
  </article>
</BaseLayout>
