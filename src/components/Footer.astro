---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-paper-300 bg-paper-100 mt-20 text-ink-600 text-xs">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div class="md:col-span-2 space-y-2.5">
        <div class="flex items-center space-x-2">
          <div class="w-6 h-6 rounded bg-brand-blue text-white flex items-center justify-center font-bold text-xs">
            VR
          </div>
          <span class="text-sm font-bold text-ink-900 tracking-tight">
            VideoGen Reviews
          </span>
        </div>
        <p class="text-ink-500 max-w-sm leading-relaxed text-xs">
          Independent architectural guides, side-by-side feature comparisons, and pricing tracking across modern generative AI video platforms.
        </p>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-ink-900 mb-3">
          Core Guides
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/everygen-ai-alternatives/" class="hover:text-brand-blue transition-colors">Everygen AI Alternatives</a></li>
          <li><a href="/everygen-ai-review/" class="hover:text-brand-blue transition-colors">Everygen Architecture Review</a></li>
          <li><a href="/is-everygen-ai-free/" class="hover:text-brand-blue transition-colors">Everygen Free Quota Guide</a></li>
          <li><a href="/" class="hover:text-brand-blue transition-colors">Everygen AI Overview</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-ink-900 mb-3">
          Editorial & Legal
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/about/" class="hover:text-brand-blue transition-colors">About VideoGen Reviews</a></li>
          <li><a href="/affiliate-disclosure/" class="hover:text-brand-blue transition-colors">Affiliate Disclosure</a></li>
          <li><a href="/privacy-policy/" class="hover:text-brand-blue transition-colors">Privacy Policy</a></li>
          <li><a href="/contact/" class="hover:text-brand-blue transition-colors">Contact & Corrections</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-paper-300 pt-6 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-ink-500">
      <p class="text-center md:text-left leading-relaxed">
        <strong>Editorial Independence:</strong> videogenreviews.com is an independent review publication, not affiliated with any evaluated product. All product names, logos, and trademarks belong to their respective owners.
      </p>
      <p class="shrink-0 text-ink-400">
        &copy; {currentYear} VideoGen Reviews.
      </p>
    </div>
  </div>
</footer>
