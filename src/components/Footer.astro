---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-800/80 bg-slate-950 mt-16 text-slate-400 text-xs">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center space-x-2">
          <div class="w-6 h-6 rounded bg-sky-500/20 text-sky-400 flex items-center justify-center font-bold text-xs">
            V
          </div>
          <span class="text-sm font-semibold text-slate-200">VideoGenReviews</span>
        </div>
        <p class="text-slate-400 max-w-sm leading-relaxed">
          Unbiased benchmark data, real generation latency tests, and side-by-side free tier comparisons across leading generative AI video engines.
        </p>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-3">Quick Reviews</h4>
        <ul class="space-y-2">
          <li><a href="/everygen-ai-alternatives/" class="hover:text-sky-400 transition-colors">Everygen AI Alternatives</a></li>
          <li><a href="/everygen-ai-review/" class="hover:text-sky-400 transition-colors">Everygen In-Depth Review</a></li>
          <li><a href="/is-everygen-ai-free/" class="hover:text-sky-400 transition-colors">Is Everygen Free?</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 mb-3">Editorial Policy</h4>
        <ul class="space-y-2">
          <li><span class="text-slate-400">Strict Independent Testing</span></li>
          <li><span class="text-slate-400">Zero Sponsored Rankings</span></li>
          <li><span class="text-slate-400">Real Failure-Case Logs</span></li>
        </ul>
      </div>
    </div>

    <!-- 核心合规免责声明与独立声明 -->
    <div class="border-t border-slate-800/60 pt-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-slate-500 text-center md:text-left leading-relaxed">
        <strong>Disclaimer:</strong> videogenreviews.com is an independent review site, not affiliated with any listed product. Product names, logos, and brands are property of their respective owners.
      </p>
      <p class="text-slate-500 shrink-0">
        &copy; {currentYear} VideoGenReviews. All rights reserved.
      </p>
    </div>
  </div>
</footer>
