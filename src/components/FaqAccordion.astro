---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

<div class="my-14">
  <div class="mb-6">
    <div class="flex items-center space-x-2 text-xs font-mono font-bold uppercase tracking-wider text-sky-400 mb-2">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
      <span>Direct Answers</span>
    </div>
    <h3 class="text-2xl md:text-3xl font-black text-white tracking-tight font-display">
      Frequently Asked Questions
    </h3>
    <p class="text-xs md:text-sm text-slate-400 mt-1">
      Unfiltered, verified answers from hands-on lab stress testing.
    </p>
  </div>

  <div class="space-y-3.5">
    {faqs.map((faq) => (
      <details class="group rounded-2xl border border-white/[0.08] bg-dark-900/40 p-5 open:bg-dark-850/80 open:border-sky-500/30 transition-all duration-200">
        <summary class="flex cursor-pointer items-center justify-between text-sm md:text-base font-bold text-slate-200 group-hover:text-sky-300 font-display transition-colors">
          <span>{faq.question}</span>
          <span class="ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-dark-800 border border-white/[0.06] text-slate-400 group-open:rotate-180 group-open:text-sky-400 transition-all duration-200">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="mt-4 text-xs md:text-sm text-slate-300 leading-relaxed border-t border-white/[0.06] pt-3.5">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>
</div>
