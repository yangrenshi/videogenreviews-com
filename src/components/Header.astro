---
const navItems = [
  { label: 'Alternatives', href: '/everygen-ai-alternatives/' },
  { label: 'Pricing', href: '/everygen-ai-pricing/' },
  { label: 'Free Tier', href: '/is-everygen-ai-free/' },
  { label: 'Review', href: '/everygen-ai-review/' },
];
---

<header class="border-b border-paper-300 bg-white/95 backdrop-blur-sm sticky top-0 z-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center space-x-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-brand-blue text-white flex items-center justify-center font-bold text-sm shadow-sm">
        VR
      </div>
      <div class="flex flex-col">
        <span class="text-base font-bold text-ink-900 group-hover:text-brand-blue transition-colors tracking-tight">
          VideoGen <span class="text-brand-blue">Reviews</span>
        </span>
        <span class="text-[10px] uppercase font-semibold text-ink-500 tracking-wider">
          Editorial Lab
        </span>
      </div>
    </a>

    <!-- Nav Items & Action -->
    <nav class="hidden md:flex items-center space-x-6 text-sm font-medium">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-ink-700 hover:text-brand-blue transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href="/everygen-ai-alternatives/"
        class="inline-flex items-center justify-center px-3.5 py-1.5 rounded-md text-xs font-semibold text-white bg-brand-blue hover:bg-brand-hover transition-colors shadow-sm"
      >
        Best Picks (2026)
      </a>
    </nav>
  </div>
</header>
