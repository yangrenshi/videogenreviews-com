---
const navItems = [
  { label: 'Alternatives', href: '/everygen-ai-alternatives/' },
  { label: 'Free Tier Test', href: '/is-everygen-ai-free/' },
  { label: 'Everygen Review', href: '/everygen-ai-review/' },
];
---

<header class="border-b border-white/[0.08] bg-dark-950/70 backdrop-blur-xl sticky top-0 z-50 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-18 py-3.5 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center space-x-3 group">
      <div class="relative">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-sky-400 via-indigo-500 to-cyan-400 p-[1px] shadow-lg shadow-sky-500/20 group-hover:shadow-sky-400/40 transition-all duration-300">
          <div class="w-full h-full bg-dark-900 rounded-[11px] flex items-center justify-center">
            <svg class="w-5 h-5 text-sky-400 group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24" fill="currentColor">
              <path d="M4.5 5.653c0-1.426 1.529-2.33 2.779-1.643l11.54 6.348c1.295.712 1.295 2.573 0 3.285L7.28 19.991c-1.25.687-2.779-.217-2.779-1.643V5.653z" />
            </svg>
          </div>
        </div>
        <span class="absolute -top-1 -right-1 flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-cyan-500"></span>
        </span>
      </div>

      <div class="flex flex-col">
        <span class="text-base sm:text-lg font-black tracking-tight text-white group-hover:text-sky-300 transition-colors font-display">
          VideoGen<span class="bg-gradient-to-r from-sky-400 to-cyan-300 bg-clip-text text-transparent">Reviews</span>
        </span>
        <span class="text-[10px] tracking-widest uppercase font-mono font-semibold text-slate-400 -mt-0.5">
          Lab Benchmarks
        </span>
      </div>
    </a>

    <!-- Nav Items & Action -->
    <nav class="hidden md:flex items-center space-x-1 lg:space-x-2 text-xs font-semibold">
      <div class="flex items-center bg-dark-900/80 p-1 rounded-full border border-white/[0.06] mr-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="px-3.5 py-1.5 rounded-full text-slate-300 hover:text-white hover:bg-white/[0.06] transition-all duration-200"
          >
            {item.label}
          </a>
        ))}
      </div>

      <a
        href="/everygen-ai-alternatives/"
        class="relative inline-flex items-center justify-center px-4 py-2 rounded-full font-bold text-xs text-dark-950 bg-gradient-to-r from-cyan-400 via-sky-400 to-indigo-300 hover:brightness-110 shadow-glow-cyan transition-all duration-300 transform hover:-translate-y-0.5"
      >
        <span>Top 10 Ranked</span>
        <svg class="w-3.5 h-3.5 ml-1 text-dark-950" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </nav>
  </div>
</header>
