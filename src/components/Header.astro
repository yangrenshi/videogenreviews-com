---
const navItems = [
  { label: 'Alternatives', href: '/everygen-ai-alternatives/' },
  { label: 'Free Tier Test', href: '/is-everygen-ai-free/' },
  { label: 'Everygen Review', href: '/everygen-ai-review/' },
];
---

<header class="border-b border-slate-800/80 bg-slate-950/80 backdrop-blur sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center space-x-2.5 group">
      <div class="w-9 h-9 rounded-lg bg-gradient-to-tr from-sky-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-sky-500/20 group-hover:scale-105 transition-transform duration-200">
        <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
          <path d="M4.5 5.653c0-1.426 1.529-2.33 2.779-1.643l11.54 6.348c1.295.712 1.295 2.573 0 3.285L7.28 19.991c-1.25.687-2.779-.217-2.779-1.643V5.653z" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-base font-bold tracking-tight text-white group-hover:text-sky-400 transition-colors">
          VideoGen<span class="text-sky-400">Reviews</span>
        </span>
        <span class="text-[10px] tracking-wider uppercase text-slate-400 font-medium">Independent AI Testing</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center space-x-7 text-sm font-medium">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="text-slate-300 hover:text-sky-400 transition-colors py-1"
        >
          {item.label}
        </a>
      ))}
      <a
        href="/everygen-ai-alternatives/"
        class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-sky-500 hover:bg-sky-400 text-slate-950 font-semibold text-xs transition-colors shadow-sm"
      >
        Top Alternatives
      </a>
    </nav>
  </div>
</header>
