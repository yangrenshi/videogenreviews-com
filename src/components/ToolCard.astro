---
interface Props {
  rank: number;
  name: string;
  badge?: string;
  tagline: string;
  rating: string;
  whyChosen: string;
  idealFor: string;
  biggestFlaw: string;
  freeTierDetails: string;
  pricingStarts: string;
  visitUrl: string;
}

const {
  rank,
  name,
  badge,
  tagline,
  rating,
  whyChosen,
  idealFor,
  biggestFlaw,
  freeTierDetails,
  pricingStarts,
  visitUrl,
} = Astro.props;
---

<div class="my-8 rounded-xl border border-slate-800 bg-slate-900/60 p-6 md:p-8 hover:border-slate-700 transition-all shadow-md">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-5 border-b border-slate-800/80 pb-5">
    <div>
      <div class="flex items-center space-x-3 mb-1">
        <span class="flex items-center justify-center w-7 h-7 rounded-full bg-slate-800 text-sky-400 font-bold text-xs border border-slate-700">
          #{rank}
        </span>
        <h3 class="text-xl md:text-2xl font-bold text-white tracking-tight">{name}</h3>
        {badge && (
          <span class="px-2 py-0.5 rounded text-xs font-semibold bg-sky-500/10 text-sky-400 border border-sky-500/20">
            {badge}
          </span>
        )}
      </div>
      <p class="text-xs md:text-sm text-slate-400">{tagline}</p>
    </div>

    <div class="flex items-center space-x-4">
      <div class="text-right">
        <div class="text-xs text-slate-400 uppercase tracking-wider font-semibold">Score</div>
        <div class="text-lg font-bold text-emerald-400">{rating} <span class="text-xs text-slate-500">/ 5.0</span></div>
      </div>
      <a
        href={visitUrl}
        rel="nofollow noopener noreferrer"
        target="_blank"
        class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-xs transition-colors shadow-sm"
      >
        Visit Official Site &rarr;
      </a>
    </div>
  </div>

  <div class="space-y-4 text-sm leading-relaxed text-slate-300">
    <div>
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Why It Earned a Spot</h4>
      <p class="text-slate-300">{whyChosen}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 py-2">
      <div class="rounded-lg bg-slate-950/60 p-3.5 border border-slate-800">
        <span class="text-xs font-semibold text-slate-400 block mb-1">Free Allowance</span>
        <span class="text-xs font-mono text-slate-200">{freeTierDetails}</span>
      </div>
      <div class="rounded-lg bg-slate-950/60 p-3.5 border border-slate-800">
        <span class="text-xs font-semibold text-slate-400 block mb-1">Paid Starts At</span>
        <span class="text-xs font-semibold text-slate-200">{pricingStarts}</span>
      </div>
    </div>

    <div>
      <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Best Suited For</h4>
      <p class="text-slate-300">{idealFor}</p>
    </div>

    <!-- 核心差异化：真实致命缺点警示 -->
    <div class="rounded-lg bg-rose-950/20 border border-rose-900/40 p-4">
      <div class="flex items-start space-x-2.5">
        <svg class="w-4 h-4 text-rose-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-rose-400 block">The Uncensored Flaw</span>
          <p class="text-xs md:text-sm text-rose-200/90 mt-0.5 leading-relaxed font-medium">{biggestFlaw}</p>
        </div>
      </div>
    </div>
  </div>
</div>
