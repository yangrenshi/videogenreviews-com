---
export interface MetricScore {
  label: string;
  score: number; // 0 to 10
}

interface Props {
  name: string;
  bestForTitle: string;
  tagline: string;
  totalScore: string; // e.g. "8.8" or "6.4"
  metrics: MetricScore[];
  whyChosen: string;
  pros: string[];
  cons: string[];
  freeTier: string;
  pricing: string;
  visitUrl: string;
  screenshotUrl?: string;
  screenshotCaption?: string;
}

const {
  name,
  bestForTitle,
  tagline,
  totalScore,
  metrics,
  whyChosen,
  pros,
  cons,
  freeTier,
  pricing,
  visitUrl,
  screenshotUrl,
  screenshotCaption,
} = Astro.props;

const numScore = parseFloat(totalScore);
---

<section class="border-t border-paper-300 pt-10 pb-8 space-y-6">
  <!-- Zapier 风格场景大标题 -->
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
    <div>
      <span class="text-xs font-semibold text-brand-blue uppercase tracking-wider block mb-1">
        {name}
      </span>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-ink-900 tracking-tight">
        {bestForTitle}
      </h3>
    </div>
  </div>

  <p class="text-base text-ink-700 leading-relaxed font-normal">
    {tagline}
  </p>

  <!-- Curious Refuge 风格：大号总分 + 5 维细分条形图 Scorecard -->
  <div class="rounded-lg border border-paper-300 bg-paper-100 p-5 sm:p-6 my-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 border-b border-paper-300/80 pb-5 mb-5">
      <div>
        <span class="text-xs uppercase font-semibold text-ink-500 tracking-wider">Editorial Benchmark Score</span>
        <div class="flex items-baseline space-x-2 mt-1">
          <span class={`text-4xl sm:text-5xl font-extrabold tracking-tight ${
            numScore >= 8.0 ? 'text-ink-900' : numScore >= 7.0 ? 'text-blue-800' : 'text-amber-700'
          }`}>
            {totalScore}
          </span>
          <span class="text-sm font-semibold text-ink-500">/ 10</span>
        </div>
      </div>

      <div class="flex items-center space-x-4">
        <a
          href={visitUrl}
          rel="sponsored nofollow noopener noreferrer"
          target="_blank"
          class="inline-flex items-center justify-center px-4 py-2 rounded-md bg-ink-900 hover:bg-brand-blue text-white font-medium text-xs transition-colors shadow-sm"
        >
          <span>Visit {name}</span>
          <svg class="w-3.5 h-3.5 ml-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- 5 维条形图 -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-4">
      {metrics.map((m) => (
        <div class="space-y-1.5">
          <div class="flex justify-between text-xs text-ink-700">
            <span class="truncate pr-1">{m.label}</span>
            <span class="font-semibold text-ink-900">{m.score.toFixed(1)}</span>
          </div>
          <div class="w-full bg-paper-300 h-1.5 rounded-full overflow-hidden">
            <div
              class={`h-full rounded-full ${
                m.score >= 8.5 ? 'bg-emerald-600' : m.score >= 7.0 ? 'bg-blue-600' : 'bg-amber-600'
              }`}
              style={`width: ${m.score * 10}%`}
            ></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- 正文分析段落 -->
  <div class="space-y-4 text-ink-800 text-sm sm:text-base leading-relaxed">
    <p>{whyChosen}</p>
  </div>

  <!-- 可选实机控制台截图 (浅底极简细边框) -->
  {screenshotUrl && (
    <figure class="my-5 rounded-lg overflow-hidden border border-paper-300 bg-paper-100 p-2 shadow-sm">
      <img
        src={screenshotUrl}
        alt={screenshotCaption || `${name} platform interface`}
        loading="lazy"
        decoding="async"
        class="w-full h-auto rounded border border-paper-300/80 object-cover"
      />
      {screenshotCaption && (
        <figcaption class="text-[11px] text-ink-500 text-center pt-2 pb-1 font-medium">
          {screenshotCaption}
        </figcaption>
      )}
    </figure>
  )}

  <!-- Zapier 风格 Pros / Cons 双列对比 -->
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
    <div class="rounded-lg bg-emerald-50/50 border border-emerald-200/80 p-4">
      <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-900 mb-2 flex items-center">
        <svg class="w-4 h-4 text-emerald-600 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
        Pros
      </h4>
      <ul class="text-xs sm:text-sm space-y-1.5 text-ink-800">
        {pros.map((p) => (
          <li class="flex items-start">
            <span class="text-emerald-600 font-bold mr-2">&bull;</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="rounded-lg bg-rose-50/50 border border-rose-200/80 p-4">
      <h4 class="text-xs font-bold uppercase tracking-wider text-rose-900 mb-2 flex items-center">
        <svg class="w-4 h-4 text-rose-600 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
        Cons
      </h4>
      <ul class="text-xs sm:text-sm space-y-1.5 text-ink-800">
        {cons.map((c) => (
          <li class="flex items-start">
            <span class="text-rose-600 font-bold mr-2">&bull;</span>
            <span>{c}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- 规格行 (At a glance specifications) -->
  <div class="flex flex-wrap gap-x-6 gap-y-2 pt-2 text-xs text-ink-600 border-t border-paper-200">
    <div><strong>Free Tier:</strong> {freeTier}</div>
    <div><strong>Pricing:</strong> {pricing}</div>
  </div>
</section>
