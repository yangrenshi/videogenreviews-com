---
export interface BreadcrumbCrumb {
  label: string;
  href?: string;
}

interface Props {
  crumbs: BreadcrumbCrumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center space-x-2 text-xs text-ink-500">
    <li>
      <a href="/" class="hover:text-brand-blue transition-colors">
        Home
      </a>
    </li>
    {crumbs.map((crumb) => (
      <li class="flex items-center space-x-2">
        <span class="text-paper-300">/</span>
        {crumb.href ? (
          <a href={crumb.href} class="hover:text-brand-blue transition-colors">
            {crumb.label}
          </a>
        ) : (
          <span class="text-ink-800 font-medium" aria-current="page">
            {crumb.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
