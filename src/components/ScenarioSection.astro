---
interface ScenarioItem {
  title: string;
  recommendedTool: string;
  badge: string;
  color: 'cyan' | 'indigo' | 'amber' | 'emerald';
  rationale: string;
}

const scenarios: ScenarioItem[] = [
  {
    title: 'TikTok & Shorts Viral Creators (9:16 Vertical)',
    recommendedTool: 'Kling AI 1.5',
    badge: 'Native Dynamics',
    color: 'cyan',
    rationale:
      'Native vertical resolution with no awkward letterbox cropping. Handles explosive dance movements, liquid splashes, and human anatomy without rubbery warping.',
  },
  {
    title: 'Commercial Ads & E-Commerce Product Reels',
    recommendedTool: 'Runway Gen-3 Alpha',
    badge: 'Director Control',
    color: 'indigo',
    rationale:
      'Multi-motion brush and reproducible camera velocities allow exact 360-degree product orbits. Critical for brand consistency and packaging sharpness.',
  },
  {
    title: 'Cinematic Storytelling & Indie Film Moodboards',
    recommendedTool: 'Luma Dream Machine 1.6',
    badge: 'Volumetric Depth',
    color: 'amber',
    rationale:
      'Anamorphic lens flares, authentic golden-hour volumetric mist, and organic lighting gradients that make scenes look filmed rather than mathematically rendered.',
  },
  {
    title: '100% Zero-Dollar Budget Prototyping',
    recommendedTool: 'Hailuo AI (MiniMax)',
    badge: 'No-Card Daily Free',
    color: 'emerald',
    rationale:
      'Refills generous generation credits daily without requiring credit card registration upfront. Exceptional photorealistic face fidelity right out of the box.',
  },
];
---

<div class="my-12">
  <div class="mb-6">
    <div class="flex items-center space-x-2 text-xs font-mono font-bold uppercase tracking-wider text-sky-400 mb-2">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
      <span>Decision Navigator</span>
    </div>
    <h3 class="text-2xl md:text-3xl font-black text-white tracking-tight font-display">
      Best AI Video Tool by Production Workflow
    </h3>
    <p class="text-xs md:text-sm text-slate-400 mt-1">
      Matched directly to specific format requirements to avoid wasted trial subscriptions.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {scenarios.map((s) => (
      <div class="relative overflow-hidden rounded-2xl border border-white/[0.08] bg-dark-900/60 p-6 hover:border-white/[0.18] transition-all duration-300 group shadow-lg backdrop-blur-sm">
        <div class="flex items-center justify-between mb-3">
          <span class="text-[10px] font-mono font-bold px-2.5 py-0.5 rounded-full bg-white/[0.05] text-slate-300 border border-white/[0.08]">
            {s.badge}
          </span>
          <span class="text-sm font-black font-display text-sky-300 group-hover:text-cyan-300 transition-colors">
            {s.recommendedTool}
          </span>
        </div>
        <h4 class="text-base font-bold text-white mb-2 font-display">{s.title}</h4>
        <p class="text-xs text-slate-400 leading-relaxed">{s.rationale}</p>
      </div>
    ))}
  </div>
</div>
