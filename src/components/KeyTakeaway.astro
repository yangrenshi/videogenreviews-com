---
interface Props {
  pickA: string;
  forScenarioA: string;
  pickB: string;
  forScenarioB: string;
  pickC?: string;
  forScenarioC?: string;
}

const { pickA, forScenarioA, pickB, forScenarioB, pickC, forScenarioC } = Astro.props;
---

<div class="my-8 rounded-lg border border-slate-200 bg-paper-100 p-5 sm:p-6 border-l-4 border-l-brand-blue">
  <div class="flex items-center space-x-2 text-brand-blue mb-3">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span class="text-xs font-bold uppercase tracking-wider text-ink-900">The Quick Verdict</span>
  </div>

  <div class="space-y-2 text-sm text-ink-800 leading-relaxed font-normal">
    <p>
      &bull; <strong>If you need {forScenarioA}:</strong> Pick <span class="text-brand-blue font-bold">{pickA}</span>.
    </p>
    <p>
      &bull; <strong>If you prioritize {forScenarioB}:</strong> Choose <span class="text-brand-blue font-bold">{pickB}</span>.
    </p>
    {pickC && forScenarioC && (
      <p>
        &bull; <strong>For {forScenarioC}:</strong> Go with <span class="text-brand-blue font-bold">{pickC}</span>.
      </p>
    )}
  </div>
</div>
