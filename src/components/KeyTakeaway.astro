---
interface Props {
  pickA: string;
  forScenarioA: string;
  pickB: string;
  forScenarioB: string;
  pickC?: string;
  forScenarioC?: string;
}

const { pickA, forScenarioA, pickB, forScenarioB, pickC, forScenarioC } = Astro.props;
---

<div class="my-8 relative overflow-hidden rounded-2xl border border-sky-500/30 bg-gradient-to-r from-dark-900/95 via-dark-850/90 to-dark-900/95 p-6 md:p-7 shadow-2xl shadow-sky-950/40 backdrop-blur-md">
  <!-- 顶部渐变流光细线 -->
  <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-sky-400 to-transparent"></div>
  <!-- 左侧发光微光条 -->
  <div class="absolute top-0 left-0 w-1.5 h-full bg-gradient-to-b from-sky-400 via-indigo-500 to-cyan-400"></div>

  <div class="flex items-center justify-between gap-3 mb-4">
    <div class="flex items-center space-x-2.5">
      <div class="w-6 h-6 rounded-lg bg-sky-500/20 border border-sky-400/30 flex items-center justify-center text-sky-400">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <span class="text-xs font-black tracking-widest uppercase font-mono bg-gradient-to-r from-sky-400 to-cyan-200 bg-clip-text text-transparent">
        Bottom-Line Verdict
      </span>
    </div>
    <span class="text-[11px] font-mono font-medium text-slate-400 px-2 py-0.5 rounded-full bg-white/[0.04] border border-white/[0.08]">
      30s Cheat Sheet
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 pt-1">
    <div class="rounded-xl bg-dark-950/70 border border-sky-500/20 p-4 hover:border-sky-500/40 transition-colors">
      <div class="text-[11px] font-mono uppercase tracking-wider text-slate-400 mb-1.5 flex items-center justify-between">
        <span>If You Need</span>
        <span class="text-sky-400 font-bold">#1 Pick</span>
      </div>
      <p class="text-xs text-slate-300 mb-2 font-medium leading-relaxed">{forScenarioA}</p>
      <div class="text-sm font-black text-white flex items-center space-x-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400"></span>
        <span class="text-sky-300 font-display">{pickA}</span>
      </div>
    </div>

    <div class="rounded-xl bg-dark-950/70 border border-indigo-500/20 p-4 hover:border-indigo-500/40 transition-colors">
      <div class="text-[11px] font-mono uppercase tracking-wider text-slate-400 mb-1.5 flex items-center justify-between">
        <span>If You Need</span>
        <span class="text-indigo-400 font-bold">#2 Pick</span>
      </div>
      <p class="text-xs text-slate-300 mb-2 font-medium leading-relaxed">{forScenarioB}</p>
      <div class="text-sm font-black text-white flex items-center space-x-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
        <span class="text-indigo-300 font-display">{pickB}</span>
      </div>
    </div>

    {pickC && forScenarioC && (
      <div class="rounded-xl bg-dark-950/70 border border-emerald-500/20 p-4 hover:border-emerald-500/40 transition-colors">
        <div class="text-[11px] font-mono uppercase tracking-wider text-slate-400 mb-1.5 flex items-center justify-between">
          <span>If You Need</span>
          <span class="text-emerald-400 font-bold">#3 Pick</span>
        </div>
        <p class="text-xs text-slate-300 mb-2 font-medium leading-relaxed">{forScenarioC}</p>
        <div class="text-sm font-black text-white flex items-center space-x-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span class="text-emerald-300 font-display">{pickC}</span>
        </div>
      </div>
    )}
  </div>
</div>
