---
export interface ToolComparisonItem {
  name: string;
  badge?: string;
  bestFor: string;
  freeTier: string;
  startingPrice: string;
  score?: string;
}

interface Props {
  tools: ToolComparisonItem[];
}

const { tools } = Astro.props;
const showScore = tools.some((t) => !!t.score);
---

<div class="my-8 overflow-x-auto">
  <table class="w-full text-left border-collapse text-sm">
    <thead>
      <tr class="border-b-2 border-ink-900 bg-white text-ink-900 font-semibold text-xs uppercase tracking-wider">
        <th class="py-3 px-3 min-w-[140px]">Tool</th>
        {showScore && <th class="py-3 px-3 min-w-[90px]">Rating</th>}
        <th class="py-3 px-3 min-w-[220px]">Best For</th>
        <th class="py-3 px-3 min-w-[150px]">Free Tier</th>
        <th class="py-3 px-3 min-w-[110px]">Price</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-paper-300 text-ink-800">
      {tools.map((t, idx) => (
        <tr class={idx === 0 ? 'bg-blue-50/40 hover:bg-blue-50/70 transition-colors' : 'hover:bg-paper-100 transition-colors'}>
          <td class="py-3.5 px-3 font-semibold text-ink-900">
            <div class="flex items-center space-x-2">
              <span>{t.name}</span>
              {t.badge && (
                <span class="inline-block px-1.5 py-0.5 text-[11px] rounded font-medium bg-paper-200 text-ink-700">
                  {t.badge}
                </span>
              )}
            </div>
          </td>
          {showScore && (
            <td class="py-3.5 px-3 text-ink-900 font-bold text-xs">
              {t.score ? (
                <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold">
                  {t.score} / 10
                </span>
              ) : (
                <span class="text-ink-400 font-normal">—</span>
              )}
            </td>
          )}
          <td class="py-3.5 px-3 text-ink-700 leading-snug">
            {t.bestFor}
          </td>
          <td class="py-3.5 px-3 text-ink-600 text-xs font-normal">
            {t.freeTier}
          </td>
          <td class="py-3.5 px-3 text-ink-900 font-medium text-xs">
            {t.startingPrice}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
