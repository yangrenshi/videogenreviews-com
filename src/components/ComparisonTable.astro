---
export interface ToolComparisonItem {
  name: string;
  badge?: string;
  freeTier: string;
  startingPrice: string;
  maxDuration: string;
  watermark: 'Yes' | 'No' | 'Free Only';
  commercialUse: 'Yes' | 'Paid Only' | 'No';
  bestFor: string;
}

interface Props {
  tools: ToolComparisonItem[];
}

const { tools } = Astro.props;
---

<div class="my-8 overflow-hidden rounded-2xl border border-white/[0.08] bg-dark-900/60 shadow-2xl backdrop-blur-md">
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-xs">
      <thead>
        <tr class="border-b border-white/[0.08] bg-dark-850/90 text-slate-300 font-mono uppercase tracking-wider text-[11px]">
          <th class="py-4 px-4 font-bold sticky left-0 bg-dark-850/98 z-20 min-w-[160px] shadow-[4px_0_12px_rgba(0,0,0,0.5)]">
            Generator
          </th>
          <th class="py-4 px-4 font-bold min-w-[140px]">Free Allowance</th>
          <th class="py-4 px-4 font-bold min-w-[120px]">Starts At</th>
          <th class="py-4 px-4 font-bold min-w-[100px]">Max Clip</th>
          <th class="py-4 px-4 font-bold min-w-[110px]">Watermark</th>
          <th class="py-4 px-4 font-bold min-w-[120px]">Commercial</th>
          <th class="py-4 px-4 font-bold min-w-[160px]">Core Strength</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/[0.05] text-slate-300">
        {tools.map((t, idx) => (
          <tr class="group hover:bg-white/[0.03] transition-colors duration-150">
            <!-- 粘性首列 -->
            <td class="py-4 px-4 sticky left-0 bg-dark-900/98 group-hover:bg-dark-850/98 transition-colors z-10 shadow-[4px_0_12px_rgba(0,0,0,0.4)]">
              <div class="flex items-center space-x-2.5">
                <span class="font-bold text-white text-sm font-display tracking-tight group-hover:text-sky-300 transition-colors">
                  {t.name}
                </span>
                {t.badge && (
                  <span class={`inline-block px-2 py-0.5 text-[10px] rounded-full font-mono font-bold tracking-tight border ${
                    idx === 0 
                      ? 'bg-amber-400/10 text-amber-300 border-amber-400/30' 
                      : idx === 1
                      ? 'bg-sky-400/10 text-sky-300 border-sky-400/30'
                      : 'bg-indigo-400/10 text-indigo-300 border-indigo-400/30'
                  }`}>
                    {t.badge}
                  </span>
                )}
              </div>
            </td>

            <!-- Free Tier -->
            <td class="py-4 px-4 font-mono text-[11px] text-slate-200">
              <span class="inline-block px-2 py-1 rounded-md bg-dark-950/80 border border-white/[0.06]">
                {t.freeTier}
              </span>
            </td>

            <!-- Price -->
            <td class="py-4 px-4 font-mono font-bold text-slate-100 text-xs">
              {t.startingPrice}
            </td>

            <!-- Duration -->
            <td class="py-4 px-4 text-slate-300 font-mono text-[11px]">
              {t.maxDuration}
            </td>

            <!-- Watermark -->
            <td class="py-4 px-4">
              <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-mono font-bold border ${
                t.watermark === 'No'
                  ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
                  : 'bg-amber-500/10 text-amber-400 border-amber-500/30'
              }`}>
                <span class={`w-1.5 h-1.5 rounded-full mr-1.5 ${
                  t.watermark === 'No' ? 'bg-emerald-400' : 'bg-amber-400'
                }`}></span>
                {t.watermark}
              </span>
            </td>

            <!-- Commercial -->
            <td class="py-4 px-4">
              <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-mono font-bold border ${
                t.commercialUse === 'Yes'
                  ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30'
                  : 'bg-dark-800 text-slate-400 border-white/[0.08]'
              }`}>
                {t.commercialUse}
              </span>
            </td>

            <!-- Best For -->
            <td class="py-4 px-4 text-slate-300 text-xs leading-relaxed">
              {t.bestFor}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
