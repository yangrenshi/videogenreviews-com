---
export interface ToolComparisonItem {
  name: string;
  badge?: string;
  freeTier: string;
  startingPrice: string;
  maxDuration: string;
  watermark: 'Yes' | 'No' | 'Free Only';
  commercialUse: 'Yes' | 'Paid Only' | 'No';
  bestFor: string;
}

interface Props {
  tools: ToolComparisonItem[];
}

const { tools } = Astro.props;
---

<div class="my-8 overflow-x-auto rounded-xl border border-slate-800 bg-slate-900/40 shadow-xl">
  <table class="w-full text-left border-collapse text-xs md:text-sm">
    <thead>
      <tr class="border-b border-slate-800 bg-slate-900/90 text-slate-300">
        <th class="p-3.5 font-semibold sticky left-0 bg-slate-900/95 z-10 min-w-[140px]">Generator</th>
        <th class="p-3.5 font-semibold min-w-[130px]">Free Tier</th>
        <th class="p-3.5 font-semibold min-w-[110px]">Starting Price</th>
        <th class="p-3.5 font-semibold min-w-[100px]">Max Length</th>
        <th class="p-3.5 font-semibold min-w-[100px]">Watermark</th>
        <th class="p-3.5 font-semibold min-w-[110px]">Commercial</th>
        <th class="p-3.5 font-semibold min-w-[150px]">Best For</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-800/60 text-slate-300">
      {tools.map((t, idx) => (
        <tr class={idx % 2 === 0 ? 'bg-slate-950/30 hover:bg-slate-800/40' : 'bg-slate-900/20 hover:bg-slate-800/40'}>
          <td class="p-3.5 font-semibold text-white sticky left-0 bg-slate-950/95 z-10 flex items-center space-x-2">
            <span>{t.name}</span>
            {t.badge && (
              <span class="inline-block px-1.5 py-0.5 text-[10px] rounded font-medium bg-sky-500/20 text-sky-300 border border-sky-500/30">
                {t.badge}
              </span>
            )}
          </td>
          <td class="p-3.5 text-slate-300 font-mono text-[11px] md:text-xs">{t.freeTier}</td>
          <td class="p-3.5 text-slate-200 font-semibold">{t.startingPrice}</td>
          <td class="p-3.5 text-slate-300">{t.maxDuration}</td>
          <td class="p-3.5">
            <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-medium ${
              t.watermark === 'No'
                ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                : 'bg-amber-500/10 text-amber-400 border border-amber-500/20'
            }`}>
              {t.watermark}
            </span>
          </td>
          <td class="p-3.5">
            <span class={`inline-block px-2 py-0.5 rounded text-[11px] font-medium ${
              t.commercialUse === 'Yes'
                ? 'bg-emerald-500/10 text-emerald-400'
                : 'bg-slate-800 text-slate-400'
            }`}>
              {t.commercialUse}
            </span>
          </td>
          <td class="p-3.5 text-slate-300">{t.bestFor}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
